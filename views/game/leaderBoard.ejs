<% layout("/layouts/boilerplate") %>
    <style>
        body {
            font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, system-ui, sans-serif;
            color: #f1f5f9;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            /* Body height fix */
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .glass {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .glow-text {
            background: linear-gradient(to right, #60a5fa, #c084fc);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        main {
            flex-grow: 1;
            /* Pushes footer to bottom */
        }

        html[data-theme="light"] body {
            color: #5a3245 !important;
            background:
                radial-gradient(circle at 12% 8%, rgba(251, 113, 133, 0.14), transparent 36%),
                radial-gradient(circle at 88% 84%, rgba(251, 191, 36, 0.12), transparent 42%),
                #fff7f5 !important;
        }

        html[data-theme="light"] .glass {
            background: #fff4f2 !important;
            border: 1px solid rgba(225, 29, 72, 0.18) !important;
            box-shadow: 0 18px 34px -24px rgba(190, 24, 93, 0.3);
        }

        html[data-theme="light"] .bg-white\/\[0\.02\],
        html[data-theme="light"] .bg-white\/\[0\.01\],
        html[data-theme="light"] .bg-white\/5 {
            background-color: #ffefed !important;
        }

        html[data-theme="light"] .divide-white\/5 {
            border-color: rgba(225, 29, 72, 0.14) !important;
        }

        html[data-theme="light"] .border-white\/5 {
            border-color: rgba(225, 29, 72, 0.16) !important;
        }

        html[data-theme="light"] .text-white,
        html[data-theme="light"] .text-slate-200,
        html[data-theme="light"] .text-slate-300 {
            color: #4b2436 !important;
        }

        html[data-theme="light"] .text-slate-400,
        html[data-theme="light"] .text-slate-500,
        html[data-theme="light"] .text-slate-600 {
            color: #8c5d70 !important;
        }

        html[data-theme="light"] .text-indigo-300,
        html[data-theme="light"] .text-indigo-400 {
            color: #be185d !important;
        }

        html[data-theme="light"] .bg-indigo-500\/20,
        html[data-theme="light"] .bg-indigo-500\/10 {
            background-color: rgba(244, 63, 94, 0.12) !important;
        }

        html[data-theme="light"] .border-indigo-500\/20,
        html[data-theme="light"] .border-indigo-500\/10,
        html[data-theme="light"] .border-indigo-500 {
            border-color: rgba(225, 29, 72, 0.28) !important;
        }

        html[data-theme="light"] .hover\:bg-white\/\[0\.01\]:hover {
            background-color: #ffe7e6 !important;
        }

        html[data-theme="light"] .bg-yellow-400\/\[0\.02\] {
            background-color: rgba(251, 146, 60, 0.12) !important;
        }

        html[data-theme="light"] .hover\:bg-yellow-400\/\[0\.04\]:hover {
            background-color: rgba(251, 146, 60, 0.2) !important;
        }

        html[data-theme="light"] .bg-slate-300\/\[0\.01\] {
            background-color: rgba(244, 63, 94, 0.08) !important;
        }

        html[data-theme="light"] .hover\:bg-slate-300\/\[0\.03\]:hover {
            background-color: rgba(244, 63, 94, 0.14) !important;
        }

        html[data-theme="light"] .bg-orange-400\/\[0\.01\] {
            background-color: rgba(251, 146, 60, 0.08) !important;
        }

        html[data-theme="light"] .hover\:bg-orange-400\/\[0\.03\]:hover {
            background-color: rgba(251, 146, 60, 0.16) !important;
        }

        html[data-theme="light"] .leaderboard-result-btn {
            background: linear-gradient(135deg, #f43f5e, #fb7185) !important;
            color: #fff7f9 !important;
            box-shadow: 0 12px 24px -14px rgba(225, 29, 72, 0.45) !important;
        }

        html[data-theme="light"] .leaderboard-result-btn:hover {
            background: linear-gradient(135deg, #e11d48, #f43f5e) !important;
        }
    </style>

    <body class="antialiased">

        <main class="px-4 pb-6">
            <div class="max-w-md mx-auto">

                <!-- Header: Very Compact -->
                <header class="text-center py-4">
                    <p class="text-[9px] text-slate-500 uppercase tracking-[0.2em] mt-0.5">Official Daily Rankings</p>
                </header>

                <!-- Prize Banner: Compact -->
                <div class="glass rounded-xl p-2.5 mb-4">
                    <div class="flex items-center gap-4 justify-between">
                        <div class="flex items-center gap-1.5 bg-yellow-400/[0.08] border border-yellow-400/20 rounded-lg px-2.5 py-1.5">
                            <span class="text-[8px] font-bold text-yellow-300 uppercase">1st</span>
                            <img src="/assets/icons/coin.svg" alt="coin" width="11" height="11" class="w-3 h-3">
                            <span class="text-[11px] font-black text-yellow-300">10</span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-slate-300/[0.06] border border-slate-400/15 rounded-lg px-2.5 py-1.5">
                            <span class="text-[8px] font-bold text-slate-400 uppercase">2nd</span>
                            <img src="/assets/icons/coin.svg" alt="coin" width="11" height="11" class="w-3 h-3">
                            <span class="text-[11px] font-black text-slate-200">7</span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-orange-400/[0.06] border border-orange-400/15 rounded-lg px-2.5 py-1.5">
                            <span class="text-[8px] font-bold text-orange-300 uppercase">3rd</span>
                            <img src="/assets/icons/coin.svg" alt="coin" width="11" height="11" class="w-3 h-3">
                            <span class="text-[11px] font-black text-orange-300">5</span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-white/[0.02] border border-white/5 rounded-lg px-2.5 py-1.5">
                            <span class="text-[8px] font-bold text-slate-500 uppercase">4-10th</span>
                            <img src="/assets/icons/coin.svg" alt="coin" width="11" height="11" class="w-3 h-3 opacity-60">
                            <span class="text-[11px] font-bold text-slate-400">1</span>
                        </div>
                    </div>
                </div>
                <% if(isAdmin) {%>
                <div class="w-full flex items-center justify-center mb-4">
                    <form id="resultForm" action="/game/updateWinners" method="POST">
                        <button class="leaderboard-result-btn gradient-bg p-4 py-4 rounded-xl font-bold text-white shadow-lg shadow-indigo-500/30 hover:opacity-90 transition transform hover:-translate-y-1" type="button" onclick="openResultModal()">Declare Daily Result</button>
                    </form>
                </div>
                <% } %>
                <!-- Leaderboard Table -->
                <div class="glass rounded-xl overflow-hidden shadow-2xl">
                    <div class="px-4 py-2.5 border-b border-white/5 flex justify-between items-center bg-white/[0.02]">
                        <div class="flex items-center gap-2">
                            <i data-lucide="award" class="w-3.5 h-3.5 text-indigo-400"></i>
                            <span class="text-[9px] font-bold text-slate-300 uppercase tracking-wider">Global
                                Standings</span>
                        </div>
                        <span
                            class="text-[8px] font-mono bg-indigo-500/10 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/20">
                            <%= players.length %> ACTIVE USERS
                        </span>
                    </div>

                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[8px] uppercase text-slate-500 font-bold bg-white/[0.01]">
                                <th class="py-2 px-4 w-14">Rank</th>
                                <th class="py-2 px-1">Username</th>
                                <th class="py-2 px-4 text-right">Points</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            <% let rank=1; %>
                                <% for (let player of players) { %>
                                    <% let rowBg="hover:bg-white/[0.01]";
                                       let rankNumClass="text-slate-500";
                                       let rankBgClass="bg-white/5 border-white/5";
                                       if (rank===1) {
                                        rankNumClass="text-yellow-400 font-black";
                                        rankBgClass="bg-yellow-400/10 border-yellow-400/25";
                                        rowBg="bg-yellow-400/[0.02] hover:bg-yellow-400/[0.04]";
                                       } else if (rank===2) {
                                        rankNumClass="text-slate-300 font-black";
                                        rankBgClass="bg-slate-300/10 border-slate-400/20";
                                        rowBg="bg-slate-300/[0.01] hover:bg-slate-300/[0.03]";
                                       } else if (rank===3) {
                                        rankNumClass="text-orange-400 font-black";
                                        rankBgClass="bg-orange-400/10 border-orange-400/20";
                                        rowBg="bg-orange-400/[0.01] hover:bg-orange-400/[0.03]";
                                       } %>
                                        <tr class="<%= rowBg %> transition-colors group">
                                            <td class="py-2 px-4">
                                                <div class="flex items-center justify-center w-7 h-7 rounded-lg border <%= rankBgClass %>">
                                                    <span class="text-[10px] font-bold <%= rankNumClass %>">#<%= rank %></span>
                                                </div>
                                            </td>
                                            <td class="py-2 px-1">
                                                <div class="flex items-center gap-2.5">
                                                    <div
                                                        class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/10 flex items-center justify-center text-[9px] font-bold text-indigo-300">
                                                        <%= player.userName.charAt(0) %>
                                                    </div>
                                                    <div>
                                                        <p
                                                            class="text-[11px] font-bold text-slate-200 leading-none mb-0.5">
                                                            <%= player.userName %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-2 px-4 text-right">
                                                <div class="inline-flex flex-col items-end">
                                                    <span
                                                        class="text-[11px] font-black text-white font-mono tracking-tighter">
                                                        <%= player.userScore.toLocaleString() %>
                                                    </span>
                                                    <span
                                                        class="text-[6px] text-indigo-400 uppercase font-bold tracking-widest">Points</span>
                                                </div>
                                            </td>
                                        </tr>
                                        <% rank++; %>
                                            <% } %>
                        </tbody>
                    </table>

                </div>
            </div>
            
        </main>
        <% if(isAdmin) {%>
        <div id="resultModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50">
            <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 w-[90%] max-w-sm text-center shadow-2xl">
                <h3 class="text-xl font-bold text-white mb-2">Declare Daily Result</h3>
                <p class="text-slate-400 mb-6">Are you sure you want to declare today's result?</p>

                <div class="flex gap-3">
                    <button type="button" onclick="closeResultModal()" class="flex-1 py-2 rounded-xl bg-slate-700 text-white hover:bg-slate-600 transition">
                        Cancel
                    </button>
                    <button type="button" id="resultSubmitBtn" onclick="submitResultForm()" class="flex-1 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition">
                        Yes, Declare
                    </button>
                </div>
            </div>
        </div>
        <% } %>

        <script>
            const resultModal = document.getElementById("resultModal");
            const resultForm = document.getElementById("resultForm");
            const resultSubmitBtn = document.getElementById("resultSubmitBtn");

            function openResultModal() {
                if (!resultModal) return;
                resultModal.classList.remove("hidden");
                resultModal.classList.add("flex");
            }

            function closeResultModal() {
                if (!resultModal) return;
                resultModal.classList.add("hidden");
                resultModal.classList.remove("flex");
            }

            function submitResultForm() {
                if (!resultForm || !resultSubmitBtn) return;
                resultSubmitBtn.disabled = true;
                resultSubmitBtn.innerText = "Please wait...";
                resultForm.submit();
            }

            if (resultModal) {
                resultModal.addEventListener("click", function (e) {
                    if (e.target === resultModal) {
                        closeResultModal();
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', () => {
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        </script>
    </body>
