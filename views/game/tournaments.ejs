<% layout("/layouts/boilerplate") %>

<style>
  /* Premium Glass Effect */
  .premium-glass {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  
  /* Dynamic Light Theme Overrides (Supports Pink & Blue Palettes) */
  html[data-theme="light"] .premium-glass {
    background: var(--sky-surface) !important;
    border-color: var(--sky-border) !important;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05) !important;
  }
  
  html[data-theme="light"] .aurora-bg-1 { background-color: rgba(var(--sky-glow-a-rgb), 0.3) !important; }
  html[data-theme="light"] .aurora-bg-2 { background-color: rgba(var(--sky-glow-b-rgb), 0.25) !important; }
  
  /* Button overrides */
  html[data-theme="light"] .theme-btn-primary,
  html[data-theme="light"] .theme-status-live {
    background: var(--sky-accent) !important;
    color: #ffffff !important;
    border: none !important;
  }
  html[data-theme="light"] .theme-btn-primary:hover {
    background: var(--sky-accent-hover) !important;
    transform: scale(1.02);
  }
  html[data-theme="light"] .theme-btn-outline {
    background: transparent !important;
    border: 1px solid var(--sky-accent-border) !important;
    color: var(--sky-accent) !important;
  }
  html[data-theme="light"] .theme-btn-outline:hover {
    background: var(--sky-accent-soft) !important;
  }
  html[data-theme="light"] .theme-text { color: var(--sky-text) !important; }
  html[data-theme="light"] .theme-text-muted { color: var(--sky-muted) !important; }
  html[data-theme="light"] .theme-text-accent { color: var(--sky-accent) !important; }
  
  /* Text gradient fix for light mode */
  html[data-theme="light"] .title-gradient {
    background: linear-gradient(to right, var(--sky-accent), var(--sky-accent-hover)) !important;
    -webkit-background-clip: text !important;
    color: transparent !important;
  }
</style>

<div class="min-h-screen relative overflow-x-hidden font-sans pb-16">
  
  <!-- Aurora Background Effect -->
  <div class="fixed inset-0 z-[-1] pointer-events-none opacity-50">
    <div class="aurora-bg-1 absolute top-[5%] left-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-600/20 blur-[130px]"></div>
    <div class="aurora-bg-2 absolute bottom-[10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-emerald-600/15 blur-[130px]"></div>
  </div>

  <main class="flex-grow flex justify-center px-4 py-8 md:py-12 relative z-10 w-full max-w-3xl mx-auto">
    <div class="w-full flex flex-col gap-8 animate-fade-in">
      
      <!-- Header -->
      <div class="text-center pt-4">
        <p class="theme-text-accent text-xs uppercase tracking-[0.25em] text-indigo-400 font-extrabold mb-2">Tournaments</p>
        <h1 class="text-3xl md:text-4xl font-black tracking-tight theme-text text-white mb-2">
          Daily <span class="title-gradient text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Games</span>
        </h1>
        <p class="text-sm theme-text-muted text-slate-400 max-w-md mx-auto">Play, compete, and conquer the daily leaderboards.</p>
      </div>

      <!-- Tournaments List -->
      <div class="flex flex-col gap-5">
        <% if (!tournaments || !tournaments.length) { %>
          <div class="premium-glass p-8 rounded-3xl text-center">
            <span class="theme-text-muted text-slate-400 text-sm font-medium">No tournaments available right now.</span>
          </div>
        <% } else { %>
          <% tournaments.forEach((tournament) => { %>
            <article class="premium-glass rounded-3xl p-4 md:p-5 flex flex-col md:flex-row gap-5 items-center hover:scale-[1.01] transition-transform duration-300">
              
              <!-- Thumbnail -->
              <div class="w-full md:w-44 shrink-0 rounded-2xl overflow-hidden aspect-video md:aspect-[4/3] bg-slate-900 border border-slate-700/50 shadow-inner">
                <img src="<%= tournament.thumbnailUrl || '/assets/icon-512.png' %>" alt="<%= tournament.gameName %>" loading="lazy" decoding="async" class="w-full h-full object-cover">
              </div>

              <!-- Content -->
              <div class="flex-1 flex flex-col w-full text-center md:text-left">
                <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-2 mb-2">
                  <div>
                    <p class="theme-text-accent text-[10px] font-bold uppercase tracking-widest text-indigo-300 mb-1"><%= tournament.gameName %></p>
                    <h2 class="theme-text text-lg font-black text-white"><%= tournament.title %></h2>
                  </div>
                  <div>
                    <span class="inline-block px-3 py-1 text-[10px] font-bold rounded-lg border uppercase tracking-wider <%= tournament.status === 'Live' ? 'border-emerald-500/30 text-emerald-300 bg-emerald-500/10 theme-status-live' : 'border-amber-500/30 text-amber-300 bg-amber-500/10' %>">
                      <%= tournament.status %>
                    </span>
                  </div>
                </div>

                <p class="theme-text-muted text-xs text-slate-400 leading-relaxed mb-4 line-clamp-2">
                  <%= tournament.description %>
                </p>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row items-center gap-2 mt-auto">
                  <% if (tournament.status === "Live") { %>
                    <a href="<%= isAuthenticated ? tournament.playUrl : '/logInForm' %>" class="theme-btn-primary w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-[13px] text-white bg-indigo-600 hover:bg-indigo-500 transition shadow-lg text-center whitespace-nowrap">
                      <%= isAuthenticated ? "Play Now" : "Login To Play" %>
                    </a>
                    <a href="<%= isAuthenticated ? tournament.leaderboardUrl : '/logInForm' %>" class="theme-btn-outline w-full sm:w-auto px-5 py-2.5 rounded-xl font-bold text-[13px] text-slate-300 border border-slate-700 hover:bg-slate-800 transition text-center whitespace-nowrap">
                      Leaderboard
                    </a>
                  <% } else { %>
                    <button type="button" disabled class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-[13px] text-slate-500 border border-slate-800 bg-slate-900/50 cursor-not-allowed text-center">
                      Launching Soon
                    </button>
                  <% } %>
                </div>
              </div>

            </article>
          <% }) %>
        <% } %>
      </div>

    </div>
  </main>
</div>
