<% layout("/layouts/boilerplate") %>

<main class="min-h-screen bg-[#020617] px-4 md:px-6 py-8 md:py-10">
  <section class="max-w-5xl mx-auto">
    <div class="mb-8 md:mb-10">
      <p class="text-[11px] uppercase tracking-[0.24em] text-indigo-300 font-bold">Games</p>
      <h1 class="mt-2 text-2xl md:text-4xl font-black text-white">All Daily Tournaments</h1>
      <p class="mt-3 text-sm md:text-base text-slate-400 max-w-2xl">
        Browse all daily game tournaments from one place. Join daily competitions and track rankings.
      </p>
    </div>

    <% if (!tournaments || !tournaments.length) { %>
      <div class="rounded-2xl border border-slate-700/70 bg-slate-900/60 p-8 text-center text-slate-300">
        No daily tournaments available right now.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <% tournaments.forEach((tournament) => { %>
          <article class="overflow-hidden rounded-2xl border border-slate-700/70 bg-slate-900/70 shadow-xl shadow-slate-950/40">
            <div class="aspect-[16/9] w-full overflow-hidden border-b border-slate-700/60 bg-slate-950">
              <img
                src="<%= tournament.thumbnailUrl || '/assets/icon-512.png' %>"
                alt="<%= tournament.gameName %> thumbnail"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover">
            </div>

            <div class="p-5 md:p-6">
              <p class="text-[11px] font-semibold tracking-[0.2em] uppercase text-indigo-300"><%= tournament.gameName %></p>

              <div class="flex items-center justify-between gap-3">
                <h2 class="text-lg md:text-xl font-bold text-white"><%= tournament.title %></h2>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-semibold border <%= tournament.status === 'Live' ? 'border-emerald-500/40 text-emerald-300 bg-emerald-500/10' : 'border-amber-500/40 text-amber-300 bg-amber-500/10' %>">
                  <%= tournament.status %>
                </span>
              </div>
              <p class="mt-3 text-sm text-slate-400 leading-relaxed">
                <%= tournament.description %>
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                <% if (tournament.status === "Live") { %>
                  <a
                    href="<%= isAuthenticated ? tournament.playUrl : '/logInForm' %>"
                    class="inline-flex items-center justify-center rounded-xl px-4 py-2 text-xs md:text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-500 transition">
                    <%= isAuthenticated ? "Play Now" : "Login To Play" %>
                  </a>
                  <a
                    href="<%= isAuthenticated ? tournament.leaderboardUrl : '/logInForm' %>"
                    class="inline-flex items-center justify-center rounded-xl px-4 py-2 text-xs md:text-sm font-semibold border border-slate-600 text-slate-200 hover:bg-slate-800 transition">
                    <%= isAuthenticated ? "View Leaderboard" : "Login For Leaderboard" %>
                  </a>
                <% } else { %>
                  <button
                    type="button"
                    disabled
                    class="inline-flex items-center justify-center rounded-xl px-4 py-2 text-xs md:text-sm font-semibold border border-slate-700 text-slate-500 cursor-not-allowed">
                    Launching Soon
                  </button>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
