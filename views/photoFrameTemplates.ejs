<% layout("/layouts/boilerplate") %>

<style>
  .photo-frame-card {
    min-height: 300px;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page {
    background: #ffffff !important;
    color: #1e3a5f !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page h1,
  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page h2,
  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page h3 {
    color: #1e3a5f !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page .text-slate-400,
  html[data-theme="light"][data-light-palette="blue"] .photo-templates-page .text-slate-300 {
    color: #5f7d9b !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card {
    background: #ffffff !important;
    border-color: rgba(37, 99, 235, 0.2) !important;
    box-shadow: 0 12px 26px rgba(37, 99, 235, 0.06) !important;
    content-visibility: auto;
    contain-intrinsic-size: 280px 250px;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card:hover {
    background: #f8fbff !important;
    border-color: rgba(37, 99, 235, 0.34) !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card__preview {
    background: #f8fbff !important;
    border-color: rgba(37, 99, 235, 0.22) !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card .text-white {
    color: #1e3a5f !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card .text-slate-400,
  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card .text-slate-300 {
    color: #5f7d9b !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card .photo-frame-admin-delete-btn {
    border-color: rgba(37, 99, 235, 0.32) !important;
    background: rgba(37, 99, 235, 0.1) !important;
    color: #1d4ed8 !important;
  }

  html[data-theme="light"][data-light-palette="blue"] .photo-frame-card .photo-frame-admin-delete-btn:hover {
    background: rgba(37, 99, 235, 0.2) !important;
  }
</style>

<section class="photo-templates-page max-w-5xl mx-auto px-4 md:px-6 py-6 md:py-8">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h1 class="text-2xl md:text-3xl font-bold text-white">Photo Frame Templates</h1>
    <% if (currUser && currUser.isAdmin) { %>
      <a
        href="/requests/frame-templates"
        class="inline-flex items-center justify-center rounded-xl border border-indigo-500/40 bg-indigo-500/10 px-4 py-2 text-sm font-semibold text-indigo-300 hover:bg-indigo-500/20 transition"
      >
        + Create New Template
      </a>
    <% } %>
  </div>

  <% if (!permanentTemplatesReady) { %>
    <p class="mt-2 text-sm text-amber-300">
      Template storage abhi configure nahi hai, isliye list empty dikh sakti hai.
    </p>
  <% } %>

  <% if (!frameTemplates || !frameTemplates.length) { %>
    <div class="py-14 text-center">
      <h2 class="text-xl font-semibold text-white">Abhi koi photo frame template available nahi hai</h2>
      <p class="text-slate-400 mt-2">Jab admin templates add karega tab yahin par cards show ho jayenge.</p>
    </div>
  <% } else { %>
    <div class="mt-5 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
      <% frameTemplates.forEach((template, templateIndex) => { %>
        <article class="photo-frame-card group rounded-lg p-2 transition hover:bg-slate-900/50 border border-transparent hover:border-slate-800">
          <a href="/photo-frames/<%= encodeURIComponent(template.slug) %>" class="block">
            <div class="photo-frame-card__preview aspect-[5/4] rounded-md overflow-hidden bg-slate-900">
              <img src="<%= template.frameImage.previewUrl %>" alt="<%= template.name %> preview"
                class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
                fetchpriority="<%= templateIndex === 0 ? 'high' : 'low' %>"
                width="<%= Number((template.canvas && template.canvas.width) || 1080) %>"
                height="<%= Number((template.canvas && template.canvas.height) || 1080) %>">
            </div>
          </a>
          <a href="/photo-frames/<%= encodeURIComponent(template.slug) %>" class="block">
            <h3 class="mt-2 text-xs md:text-sm font-semibold text-white line-clamp-2"><%= template.name %></h3>
          </a>
          <!-- <p class="mt-1 text-xs md:text-sm text-slate-400 line-clamp-2"><%= template.description || "No description" %></p> -->

          <% if (currUser && currUser.isAdmin) { %>
            <div class="mt-2 flex items-center justify-between gap-2">
              <span class="text-[10px] rounded-full px-2 py-1 border <%= template.isActive ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300' : 'border-amber-500/30 bg-amber-500/10 text-amber-300' %>">
                <%= template.isActive ? "Active" : "Hidden" %>
              </span>
              <div class="flex items-center gap-2">
                <a
                  href="/requests/frame-templates/<%= template.id %>/edit"
                  class="photo-frame-admin-edit-btn rounded-md border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-1 text-[11px] font-semibold text-indigo-300 hover:bg-indigo-500/20 transition"
                >
                  Edit
                </a>
                <form action="/requests/frame-templates/<%= template.id %>/delete" method="POST" onsubmit="return confirm('Delete this template permanently?');">
                  <button
                    type="submit"
                    class="photo-frame-admin-delete-btn rounded-md border border-rose-500/30 bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold text-rose-300 hover:bg-rose-500/20 transition"
                  >
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
