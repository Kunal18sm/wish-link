<% layout("/layouts/boilerplate") %>
<% const cards = Array.isArray(adminCards) ? adminCards : []; %>

<section class="max-w-7xl mx-auto px-4 md:px-6 py-8 md:py-10 space-y-7">
  <div class="rounded-3xl mb-8 p-4 border border-slate-800 bg-slate-900/70 px-6 py-6 md:px-8 md:py-7 shadow-xl">
    <div class="flex flex-wrap items-start justify-between gap-5">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-indigo-300/80 font-semibold">Admin Control Center</p>
        <h1 class="mt-2 text-2xl md:text-3xl font-bold text-white">Admin Dashboard</h1>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-5">
    <% cards.forEach((card) => { %>
      <a
        href="<%= card.href %>"
        class="group relative overflow-hidden rounded-2xl border bg-slate-900/70 p-4 md:p-5 min-h-[184px] md:min-h-[198px] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgba(0,0,0,0.35)] <%= card.toneClass || 'border-slate-700' %>"
      >
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition duration-300 bg-gradient-to-br <%= card.toneClass || 'from-slate-700/20 to-slate-800/20' %> pointer-events-none"></div>

        <div class="relative h-full flex flex-col items-center text-center justify-center gap-3">
          <div class="w-14 h-14 rounded-2xl border border-white/10 bg-slate-950/80 flex items-center justify-center text-2xl md:text-3xl shadow-inner">
            <span aria-hidden="true"><%= card.icon || "🔗" %></span>
          </div>
          <h2 class="text-sm md:text-base font-semibold text-white leading-tight">
            <%= card.title %>
          </h2>
          <p class="text-xs md:text-sm text-slate-400 leading-relaxed max-w-[20ch]">
            <%= card.description %>
          </p>
        </div>
      </a>
    <% }); %>
  </div>
</section>
