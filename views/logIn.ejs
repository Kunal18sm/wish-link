<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./includes/seoHead.ejs") %>
    <script>
        (function () {
            try {
                var t = localStorage.getItem("vishlink-theme");
                if (t !== "light" && t !== "dark") t = "light";
                document.documentElement.setAttribute("data-theme", t);
            } catch (_err) {
                document.documentElement.setAttribute("data-theme", "light");
            }
        })();
    </script>

    <link rel="stylesheet" href="/output.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/design.css?v=<%= assetVersion %>">
    <!-- Google Analytics (lazy loaded after page becomes idle) -->
    <script>
        (function () {
            var gaLoaded = false;

            function loadGa() {
                if (gaLoaded) return;
                gaLoaded = true;

                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
                window.gtag("js", new Date());
                window.gtag("config", "G-L0F12E1ENT");

                var gaScript = document.createElement("script");
                gaScript.async = true;
                gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-L0F12E1ENT";
                document.head.appendChild(gaScript);
            }

            window.addEventListener("load", function () {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadGa, { timeout: 2500 });
                } else {
                    setTimeout(loadGa, 1200);
                }
            }, { once: true });
        })();
    </script>
    <% if (googleClientId) { %>
      <script src="https://accounts.google.com/gsi/client" async defer></script>
    <% } %>
    <style>
        body { font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, system-ui, sans-serif; }
        .glass-box {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .input-style {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(71, 85, 105, 0.5);
            transition: all 0.3s ease;
        }
        .input-style:focus {
            border-color: #818cf8;
            background: rgba(30, 41, 59, 0.8);
            outline: none;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
        }
        .blob {
            position: absolute;
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            filter: blur(80px);
            border-radius: 50%;
            z-index: -1;
            opacity: 0.4;
        }
    </style>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
    <%- include("./includes/flash.ejs") %>
    <div class="blob top-[-10%] left-[-10%]"></div>
    <div class="blob bottom-[-10%] right-[-10%] animate-pulse"></div>

    <div class="w-full max-w-md">
        <div class="text-center mb-10">
            <a href="/" class="text-3xl font-extrabold bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">
                VishLink
            </a>
            <p class="text-slate-500 mt-2">Join the elite community of developers.</p>
        </div>

        <div class="glass-box p-8 rounded-3xl">
            <h2 class="text-2xl font-bold text-white mb-6 text-center">Welcome Back</h2>
            
            <form id="LoginForm" action="/login" method="POST" class="space-y-5">
    
                <div>
                    <label class="block text-sm font-medium mb-1.5 text-slate-400 ml-1">User name</label>
                    <input type="text" placeholder="User name" name="username"
                           class="w-full px-4 py-3 rounded-xl input-style text-white placeholder-slate-600">
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1.5 text-slate-400 ml-1">Password</label>
                    <input type="password" placeholder="••••••••" name="password"
                           class="w-full px-4 py-3 rounded-xl input-style text-white placeholder-slate-600">
                    <p class="text-[10px] text-slate-500 mt-2 px-1">Must be at least 8 characters with numbers.</p>
                </div>


                <button id="submitBtn" type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 py-3.5 rounded-xl font-bold text-white shadow-xl shadow-indigo-500/20 hover:scale-[1.02] active:scale-[0.98] transition duration-200">
                    Log in
                </button>
            </form>

            <% if (googleClientId) { %>
              <div class="my-5 flex items-center gap-3">
                  <span class="h-px flex-1 bg-slate-700"></span>
                  <span class="text-xs uppercase tracking-wider text-slate-500">or</span>
                  <span class="h-px flex-1 bg-slate-700"></span>
              </div>
              <div class="flex justify-center">
                <div id="googleSignInBtn"></div>
              </div>
            <% } %>


            

            <p class="text-center mt-8 text-sm text-slate-400">
                Don't have an account <a href="/signUpForm" class="text-indigo-400 font-bold hover:underline">Sign up</a>
            </p>
        </div>

        <div class="mt-8 text-center text-slate-600 text-[11px] uppercase tracking-widest">
            Secured by VishLink Auth v2.0
        </div>
    </div>

    <script>
        const form = document.getElementById("LoginForm");
        const btn = document.getElementById("submitBtn");
        form.addEventListener("submit", function () {
            btn.disabled = true;
            btn.innerText = "Please wait...";
        });

        <% if (googleClientId) { %>
        async function handleGoogleCredentialResponse(response) {
            try {
                const loginResponse = await fetch("/auth/google", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ credential: response.credential }),
                });

                const payload = await loginResponse.json();
                if (!loginResponse.ok || !payload.ok) {
                    alert(payload.message || "Google sign-in failed.");
                    return;
                }

                window.location.href = payload.redirectTo || "/";
            } catch (_err) {
                alert("Google sign-in failed. Please try again.");
            }
        }

        window.addEventListener("load", function () {
            if (!window.google || !window.google.accounts || !window.google.accounts.id) return;

            window.google.accounts.id.initialize({
                client_id: "<%= googleClientId %>",
                callback: handleGoogleCredentialResponse,
                ux_mode: "popup",
                auto_select: false,
            });

            window.google.accounts.id.renderButton(
                document.getElementById("googleSignInBtn"),
                { theme: "outline", size: "large", shape: "pill", text: "continue_with", width: 280 }
            );
        });
        <% } %>
    </script>
</body>
</html>
