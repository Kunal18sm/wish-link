<% layout("/layouts/boilerplate") %>

<div class="bg-[#0B1120] text-slate-200 h-dvh pt-[74px] font-sans relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-indigo-900/20 via-[#0B1120] to-emerald-900/10 pointer-events-none"></div>

  <main class="h-full max-w-5xl mx-auto px-0 md:px-5 pb-2 md:pb-3 overflow-hidden">
    <div class="h-full min-h-0 bg-slate-900/70 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
      <div class="mt-16 px-4 md:px-6 py-3 md:py-4 border-b border-slate-800 flex items-start justify-between gap-3 shrink-0">
        <div class="min-w-0">
          <a href="/chat/admin" class="inline-block text-indigo-400 hover:text-indigo-300 text-xs md:text-sm mb-1">Back to Chat Requests</a>
          <h1 class="text-lg md:text-2xl font-bold text-white truncate">Chat: <%= chat.user?.username || "Unknown User" %></h1>
          <p class="text-slate-400 text-xs md:text-sm truncate"><%= chat.user?.email || "No email" %></p>
        </div>
        <button
          type="button"
          id="openDeleteModalBtn"
          class="px-3 md:px-4 py-2 rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/30 hover:bg-rose-600 hover:text-white transition text-xs md:text-sm font-semibold shrink-0"
        >
          Delete Thread
        </button>
      </div>

      <div id="chatScrollBox" class="mb-32 flex-1 min-h-0 overflow-y-auto px-3 md:px-5 py-4">
        <% if (!chat.messages.length) { %>
          <div id="emptyState" class="h-full flex items-center justify-center text-center border border-dashed border-slate-700 rounded-2xl bg-slate-800/30 p-8">
            <div>
              <h3 class="text-lg font-bold text-slate-200">No messages in this thread</h3>
              <p class="text-slate-500 text-sm mt-2">User has not sent anything yet.</p>
            </div>
          </div>
        <% } %>

        <div id="messageList" class="space-y-4">
          <% if (chat.messages.length) { %>
            <% for (let msg of chat.messages) { %>
              <% const isAdminMessage = msg.senderRole === "admin"; %>
              <div data-message-id="<%= msg._id %>" class="mb-1 flex <%= isAdminMessage ? 'justify-end' : 'justify-start' %>">
                <div class="<%= isAdminMessage ? 'bg-indigo-600/90 border-indigo-500/60 text-white' : 'bg-slate-800 border-slate-700 text-slate-100' %> max-w-[85%] md:max-w-[72%] px-4 py-3 rounded-2xl border shadow-lg">
                  <p class="text-sm break-words whitespace-pre-wrap"><%= msg.text %></p>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

      <form id="chatForm" action="/chat/admin/<%= chat._id %>/message" method="POST" class="border-t border-slate-800 p-3 md:p-4 bg-slate-950/60 shrink-0 fixed bottom-0 left-0 w-full pb-[env(safe-area-inset-bottom)]">
        <div class="flex items-end gap-2 md:gap-3">
          <textarea
            id="chatMessage"
            name="chat[message]"
            rows="2"
            maxlength="1500"
            placeholder="Reply..."
            class="flex-1 rounded-xl border border-slate-700 bg-slate-900 text-slate-100 px-4 py-3 focus:border-indigo-500 focus:outline-none resize-none"
            required
          ></textarea>
          <button
            id="sendBtn"
            type="submit"
            aria-label="Send message"
            title="Send"
            class="w-12 h-12 shrink-0 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white transition flex items-center justify-center"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.4 20.4 22 12 3.4 3.6l-.1 6.6 12.6 1.8-12.6 1.8z"/>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<div id="deleteModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[80]">
  <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 w-[90%] max-w-sm text-center shadow-2xl">
    <h3 class="text-xl font-bold text-white mb-2">Delete Entire Thread?</h3>
    <p class="text-slate-400 mb-6">This will remove all messages for this user conversation permanently.</p>

    <div class="flex gap-3">
      <button
        type="button"
        id="closeDeleteModalBtn"
        class="flex-1 py-2 rounded-xl bg-slate-700 text-white hover:bg-slate-600 transition"
      >
        Cancel
      </button>

      <form action="/chat/admin/<%= chat._id %>?_method=DELETE" method="POST" class="flex-1">
        <button
          type="submit"
          class="w-full py-2 rounded-xl bg-rose-600 text-white hover:bg-rose-700 transition"
        >
          Yes, Delete
        </button>
      </form>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  (function () {
    const chatScrollBox = document.getElementById("chatScrollBox");
    const messageList = document.getElementById("messageList");
    const emptyState = document.getElementById("emptyState");
    const chatForm = document.getElementById("chatForm");
    const chatMessage = document.getElementById("chatMessage");
    const sendBtn = document.getElementById("sendBtn");
    const activeChatId = "<%= chat._id %>";

    const deleteModal = document.getElementById("deleteModal");
    const openDeleteModalBtn = document.getElementById("openDeleteModalBtn");
    const closeDeleteModalBtn = document.getElementById("closeDeleteModalBtn");

    const knownMessageIds = new Set();
    let lastSeenMessageId = "";
    let pollingInFlight = false;

    function scrollToBottom() {
      if (chatScrollBox) chatScrollBox.scrollTop = chatScrollBox.scrollHeight;
    }

    function hideEmptyState() {
      if (emptyState) emptyState.remove();
    }

    function trackMessage(messageId) {
      if (messageId) knownMessageIds.add(String(messageId));
      if (messageId) lastSeenMessageId = String(messageId);
    }

    function seedExistingMessages() {
      const rows = messageList.querySelectorAll("[data-message-id]");
      rows.forEach((row) => {
        trackMessage(row.getAttribute("data-message-id"));
      });
    }

    function appendMessage(message) {
      if (!messageList || !message) return;
      const msgId = message._id ? String(message._id) : "";
      if (msgId && knownMessageIds.has(msgId)) return;

      hideEmptyState();

      const isAdminMessage = message.senderRole === "admin";
      const row = document.createElement("div");
      row.className = `mb-1 flex ${isAdminMessage ? "justify-end" : "justify-start"}`;
      row.setAttribute("data-message-id", msgId);

      const bubble = document.createElement("div");
      bubble.className = `${isAdminMessage ? "bg-indigo-600/90 border-indigo-500/60 text-white" : "bg-slate-800 border-slate-700 text-slate-100"} max-w-[85%] md:max-w-[72%] px-4 py-3 rounded-2xl border shadow-lg`;

      const p = document.createElement("p");
      p.className = "text-sm break-words whitespace-pre-wrap";
      p.textContent = message.text;

      bubble.appendChild(p);
      row.appendChild(bubble);
      messageList.appendChild(row);
      trackMessage(msgId);
      scrollToBottom();
    }

    function openDeleteModal() {
      deleteModal.classList.remove("hidden");
      deleteModal.classList.add("flex");
    }

    function closeDeleteModal() {
      deleteModal.classList.add("hidden");
      deleteModal.classList.remove("flex");
    }

    async function sendThroughHttp(text) {
      const body = new URLSearchParams();
      body.set("chat[message]", text);

      const response = await fetch(chatForm.action, {
        method: "POST",
        headers: { "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
        body: body.toString(),
      });

      const data = await response.json();
      if (!data.ok) throw new Error(data.error || "Failed to send message.");
      if (data.message) appendMessage(data.message);
    }

    async function pollUpdates() {
      if (pollingInFlight) return;
      pollingInFlight = true;
      try {
        const after = lastSeenMessageId ? `?afterMessageId=${encodeURIComponent(lastSeenMessageId)}` : "";
        const response = await fetch(`/chat/api/thread/${activeChatId}${after}`, { headers: { "Accept": "application/json" } });
        const data = await response.json();
        if (data.ok && Array.isArray(data.messages) && data.messages.length) {
          data.messages.forEach(appendMessage);
        }
      } catch (_err) {
        // silent fallback
      } finally {
        pollingInFlight = false;
      }
    }

    if (openDeleteModalBtn) openDeleteModalBtn.addEventListener("click", openDeleteModal);
    if (closeDeleteModalBtn) closeDeleteModalBtn.addEventListener("click", closeDeleteModal);
    if (deleteModal) {
      deleteModal.addEventListener("click", function (e) {
        if (e.target === deleteModal) closeDeleteModal();
      });
    }

    seedExistingMessages();
    scrollToBottom();

    let socket = null;
    if (typeof io === "function") {
      socket = io();

      socket.on("connect", function () {
        socket.emit("joinChat", { chatId: activeChatId });
      });

      socket.on("newChatMessage", function (payload) {
        if (!payload || !payload.message) return;
        if (String(payload.chatId) !== String(activeChatId)) return;
        appendMessage(payload.message);
      });

      socket.on("chatThreadDeleted", function (payload) {
        if (!payload || !payload.chatId) return;
        if (String(payload.chatId) !== String(activeChatId)) return;
        window.location.href = "/chat/admin";
      });
    }

    chatForm.addEventListener("submit", async function (e) {
      e.preventDefault();

      const text = chatMessage.value.trim();
      if (!text) return;

      sendBtn.disabled = true;
      sendBtn.classList.add("opacity-70", "scale-95");

      try {
        if (socket && socket.connected) {
          await new Promise((resolve, reject) => {
            socket.emit("sendChatMessage", { chatId: activeChatId, text }, function (response) {
              if (!response || !response.ok) return reject(new Error((response && response.error) || "Failed to send message."));
              resolve();
            });
          });
        } else {
          await sendThroughHttp(text);
        }

        chatMessage.value = "";
        chatMessage.focus();
      } catch (err) {
        alert(err.message || "Failed to send message.");
      } finally {
        sendBtn.disabled = false;
        sendBtn.classList.remove("opacity-70", "scale-95");
      }
    });

    pollUpdates();
    setInterval(pollUpdates, 2500);

  })();
</script>
