<% layout("/layouts/boilerplate") %>

<% const selectedTemplate = (frameTemplates && frameTemplates[0]) ? frameTemplates[0] : null; %>

<section id="photoFrameEditorSection" class="max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-8 overflow-x-hidden">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl md:text-3xl font-bold text-white"><%= (selectedTemplate && selectedTemplate.name) ? selectedTemplate.name : "Photo Frame Studio" %></h1>
    <a href="/photo-frames" class="text-sm text-slate-300 hover:text-white transition">
      Back To Templates
    </a>
  </div>
  

  <% if (!selectedTemplate) { %>
    <div class="mt-8 py-14 text-center">
      <h2 class="text-xl font-semibold text-white">Selected template available nahi hai</h2>
      <a href="/photo-frames" class="inline-flex mt-4 text-indigo-300 hover:text-indigo-200 font-semibold transition">
        Choose Another Template
      </a>
    </div>
  <% } else { %>
    <div class="mt-6 grid grid-cols-1 xl:grid-cols-12 gap-6">
      <div class="xl:col-span-12">
        <p id="selectedTemplateDesc" class="mt-1 text-sm text-slate-400"></p>
        <p id="selectedTemplateMeta" class="mt-1 text-xs text-slate-500"></p>

        <div class="mt-4">
          <div id="frameEditorStage" class="relative mx-auto w-full overflow-hidden rounded-lg bg-slate-900"
            style="width:min(100%,680px);aspect-ratio:1/1;">
            <div id="frameImageSlotsLayer" class="absolute inset-0"></div>
            <div id="frameTextLayer" class="absolute inset-0 pointer-events-none"></div>
            <img
              id="frameOverlayImage"
              alt="Frame overlay"
              class="absolute inset-0 h-full w-full object-cover pointer-events-none select-none"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="<%= Number((selectedTemplate && selectedTemplate.canvas && selectedTemplate.canvas.width) || 1080) %>"
              height="<%= Number((selectedTemplate && selectedTemplate.canvas && selectedTemplate.canvas.height) || 1080) %>">
          </div>
        </div>

      </div>

      <div class="mb-6 xl:col-span-12">
        <div class="mt-4 mb-6 flex flex-wrap gap-3">
          <button id="downloadFrameBtn" type="button"
            class="rounded-lg bg-indigo-600 hover:bg-indigo-500 px-4 py-2.5 text-white font-semibold transition">
            Download Final Image (<%= Number(photoFrameDownloadCredits || 1) %> Credit<%= Number(photoFrameDownloadCredits || 1) === 1 ? "" : "s" %>)
          </button>
          <button id="resetFrameBtn" type="button"
            class="rounded-lg border border-slate-600 hover:border-slate-500 px-4 py-2.5 text-slate-200 font-semibold transition">
            Reset
          </button>
        </div>
        <p id="frameStudioStatus" class="mt-2 text-sm text-slate-400"></p>
      </div>
    </div>
  <% } %>
</section>

<style>
  #photoFrameEditorSection {
    width: 100%;
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
    box-sizing: border-box;
  }

  #frameEditorStage {
    width: 100%;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    #photoFrameEditorSection {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Bangers&family=Caveat:wght@400;600&family=Dancing+Script:wght@400;600&family=Lobster&family=Lora:wght@400;600;700&family=Merriweather:wght@400;700&family=Montserrat:wght@400;600;700&family=Oswald:wght@400;600;700&family=Pacifico&family=Playfair+Display:wght@400;600;700&family=Poppins:wght@400;600;700&family=Raleway:wght@400;600;700&display=swap"
>

<div
  id="photoFrameStudioBootstrap"
  data-selected-slug="<%= selectedTemplateSlug || '' %>"
  data-is-logged-in="<%= currUser ? 'true' : 'false' %>"
  data-download-credit-cost="<%= Number(photoFrameDownloadCredits || 1) %>"
  data-login-url="/logInForm"
></div>
<script id="photoFrameTemplatesData" type="application/json"><%- JSON.stringify(frameTemplates || []).replace(/</g, "\\u003c") %></script>
<script defer src="/photoFrameStudio.js?v=<%= assetVersion %>"></script>
