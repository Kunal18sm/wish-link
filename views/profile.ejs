<% layout("/layouts/boilerplate") %>
<body class="text-slate-200 min-h-screen">

    <main class="max-w-4xl mx-auto px-6 py-10">
        <div class="relative mb-24">
            <div class="h-48 md:h-64 w-full rounded-3xl bg-gradient-to-r from-indigo-900 via-slate-800 to-purple-900 shadow-2xl overflow-hidden">
                <img src="https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=1000&q=80" alt="Cover" class="w-full h-full object-cover opacity-50">
            </div>

            <div class="absolute -bottom-16 left-8 flex flex-col md:flex-row md:items-end gap-6 w-[calc(100%-4rem)]">
                <div class="relative">
                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Avatar" class="w-32 h-32 md:w-40 md:h-40 rounded-3xl border-4 border-[#020617] bg-[#1e293b] shadow-2xl">
                </div>
                
                <div class="flex-grow pb-2">
                    <h1 class="text-3xl font-bold text-white"><%= currUser.username %></h1>
                    <p class="text-slate-200"><%= currUser.email %></p>
                </div>

            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    

            <div class="lg:col-span-2 space-y-6">
                <div class="profile-card p-8 rounded-2xl">
                    <h2 class="text-xl font-bold mb-6">Purchased links</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        
                        <% for(order of purchasedLinks){%>
                        <span class="space-y-1">
                            <label class="text-xs font-semibold text-slate-500 uppercase"><%= order.webName %> website For <%= order.receiver %>
                            
                              <% if(order.isLive){%>
                                <span class="islive">Lii</span>
                              <% } %>
                              <% if(!order.isLive){%>
                              <span class="isnotlive">Lii</span>
                              <% } %>
                          </label>
                            <% if(order.isLive){%>
                                <a href="<%= order.webUrl %>"  target="_blank" rel="noopener noreferrer"><p class="text-slate-200" id="wishLink"><%= order.webUrl %></p></a>
                                <span class="inline-flex items-center gap-3 p-2 bg-slate-800/50 border border-slate-700 rounded-lg group hover:border-indigo-500 transition-all duration-300">
                                <button onclick="copyText()" class="p-2 bg-indigo-600/10 text-indigo-400 rounded-md group-hover:bg-indigo-600 group-hover:text-white transition-all">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                                    </svg>
                                </button>
                                </span>
                            <% } %>

                            <% if(!order.isLive){%>
                                <p class="text-slate-200">website is not available</p>
                            <% } %>
                            
                            
                        </span>   
                        <% } %>
                        
                    </div>
                    
            
                </div>
            </div>
        </div>
    </main>
</body>