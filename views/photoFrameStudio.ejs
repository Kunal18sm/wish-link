<% layout("/layouts/boilerplate") %>

<section class="max-w-7xl mx-auto px-4 md:px-6 py-8 md:py-10 space-y-6">
  <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-5 md:p-7">
    <h1 class="text-2xl md:text-3xl font-bold text-white">Photo Frame Studio</h1>
    <p class="text-slate-300 mt-2 max-w-3xl">
      Template choose karein, apni photos upload karein, text edit karein aur final frame image download karein.
    </p>
    <div class="mt-4 inline-flex items-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-xs md:text-sm text-emerald-200">
      Privacy first: aapki uploaded photos/text server par save nahi hote, sab browser me hi process hota hai.
    </div>
    <% if (!permanentTemplatesReady) { %>
      <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-sm text-amber-200">
        Template storage abhi configure nahi hai, isliye list empty dikh sakti hai.
      </div>
    <% } %>
  </div>

  <% if (!frameTemplates || !frameTemplates.length) { %>
    <div class="rounded-3xl border border-dashed border-slate-700 bg-slate-900/40 px-6 py-14 text-center">
      <h2 class="text-xl font-semibold text-white">Abhi koi frame template available nahi hai</h2>
      <p class="text-slate-400 mt-2">Jab admin templates add karega tab yahin par auto show ho jayenge.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
      <aside class="xl:col-span-4 rounded-3xl border border-slate-800 bg-slate-900/60 p-5 md:p-6">
        <h2 class="text-lg font-bold text-white">Choose Template</h2>
        <p class="text-slate-400 text-sm mt-1">Ready-made designs me se ek select karein.</p>
        <div id="templateCardList" class="mt-4 space-y-3 max-h-[70vh] overflow-auto pr-1">
          <% frameTemplates.forEach((template) => { %>
            <button type="button"
              data-template-slug="<%= template.slug %>"
              class="js-template-card w-full rounded-2xl border border-slate-700 bg-slate-950/60 p-3 text-left transition hover:border-indigo-500/50 hover:bg-slate-900">
              <div class="aspect-video rounded-xl overflow-hidden border border-slate-700 bg-slate-900">
                <img src="<%= template.frameImage.previewUrl %>" alt="<%= template.name %> preview"
                  class="h-full w-full object-cover" loading="lazy" decoding="async">
              </div>
              <h3 class="mt-3 text-sm font-semibold text-white"><%= template.name %></h3>
              <p class="mt-1 text-xs text-slate-400"><%= template.description || "No description" %></p>
            </button>
          <% }) %>
        </div>
      </aside>

      <div class="xl:col-span-8 space-y-6">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-5 md:p-6">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div>
              <h2 id="selectedTemplateName" class="text-xl font-bold text-white"></h2>
              <p id="selectedTemplateDesc" class="text-sm text-slate-400 mt-1"></p>
            </div>
            <div class="text-xs text-slate-500">
              <span id="selectedTemplateMeta"></span>
            </div>
          </div>

          <div class="mt-5 rounded-2xl border border-slate-700 bg-slate-950/80 p-3">
            <div id="frameEditorStage" class="relative mx-auto overflow-hidden rounded-xl border border-slate-700 bg-slate-900"
              style="width:min(100%,640px);aspect-ratio:1/1;">
              <div id="frameImageSlotsLayer" class="absolute inset-0"></div>
              <div id="frameTextLayer" class="absolute inset-0 pointer-events-none"></div>
              <img id="frameOverlayImage" alt="Frame overlay" class="absolute inset-0 h-full w-full object-cover pointer-events-none select-none">
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-5 md:p-6">
            <h3 class="text-lg font-semibold text-white">Image Slots</h3>
            <p class="text-xs text-slate-400 mt-1">Har slot me alag photo set karein.</p>
            <div id="slotUploadControls" class="mt-4 space-y-3"></div>
          </div>

          <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-5 md:p-6">
            <h3 class="text-lg font-semibold text-white">Text Layer</h3>
            <p class="text-xs text-slate-400 mt-1">Editable texts yahan se update karein.</p>
            <div id="textControls" class="mt-4 space-y-3"></div>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-5 md:p-6">
          <div class="flex flex-col sm:flex-row gap-3">
            <button id="downloadFrameBtn" type="button"
              class="rounded-xl bg-indigo-600 hover:bg-indigo-500 px-5 py-3 text-white font-semibold transition">
              Download Final Image
            </button>
            <button id="resetFrameBtn" type="button"
              class="rounded-xl border border-slate-600 hover:border-slate-500 px-5 py-3 text-slate-200 font-semibold transition">
              Reset Current Template
            </button>
          </div>
          <p id="frameStudioStatus" class="mt-3 text-sm text-slate-400"></p>
        </div>
      </div>
    </div>
  <% } %>
</section>

<div
  id="photoFrameStudioBootstrap"
  data-selected-slug="<%= selectedTemplateSlug || '' %>"
></div>
<script id="photoFrameTemplatesData" type="application/json"><%- JSON.stringify(frameTemplates || []).replace(/</g, "\\u003c") %></script>
<script defer src="/photoFrameStudio.js?v=<%= assetVersion %>"></script>
