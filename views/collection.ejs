<% layout("/layouts/boilerplate") %>



  <style>
    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: #0f172a;
    }

    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Hide scrollbar for category list but keep functionality */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <!-- Main Wrapper (Changed from body to div for better responsiveness in layouts) -->
  <div
    class="collection-page bg-[#0B1120] text-slate-200 antialiased relative min-h-screen w-full overflow-x-hidden selection:bg-indigo-500/30"
    >

    <!-- Background Ambient Glow Effects -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
      <div
        class="absolute top-[-10%] left-[-10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-indigo-600/20 rounded-full blur-[80px] md:blur-[120px] mix-blend-screen animate-pulse">
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-emerald-500/10 rounded-full blur-[80px] md:blur-[120px] mix-blend-screen">
      </div>
    </div>

    <!-- Header Section -->
    <header class="relative max-w-7xl mx-auto px-4 md:px-6 pt-8 pb-10 text-center flex flex-col items-center">
      <!-- 2. Optimized Slidable Image Banner -->
      <%- include("includes/bannerSlider", { bannerSlides }) %>

      <!-- 4. Feedback Form -->
      
      <!-- 5. User Feedback Link (More subtle) -->
      
      <!-- 6. Category Scroller -->
      <div class="mt-2 mb-2">
        <span class="text-slate-300 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] opacity-80">Browse
          Categories</span>
      </div>
      <div class="w-full max-w-5xl overflow-hidden">
        <div class="overflow-x-auto no-scrollbar py-2">
          <div class="flex flex-nowrap gap-2 px-4 w-max mx-auto">
            <% const categories=["All", "Birthday" , "Valentine's" , "Sorry" , "Family" , "Couple"
              , "Anniversary" , "Wedding" , "Best Friend" , "Festival" , "New Year" ]; %>
              <% categories.forEach(tag=> { %>
                <a href="/category/<%= tag.toLowerCase() %>"
                  class="px-4 py-2.5 min-h-[44px] rounded-full bg-slate-900/40 border border-slate-700 text-slate-300 text-[11px] md:text-xs font-medium hover:border-indigo-500/40 hover:text-indigo-300 transition-all whitespace-nowrap inline-flex items-center">
                  <%= tag %>
                </a>
                <% }) %>
          </div>
        </div>
      </div>
    </header>


    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 md:px-6 pb-24">

      <!-- Section Header -->
      <div
        class="flex flex-col md:flex-row justify-between items-start mb-8 md:mb-12 gap-4 border-b border-slate-800 pb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-100">Featured <%= activeTag %> Collections</h2>
          <p class="text-slate-400 mt-2 text-sm md:text-base">Handpicked designs trending this week</p>
        </div>
      </div>

      <div class="mb-8 flex items-center justify-center gap-2 text-xs text-slate-500">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <p class="text-emerald-500">Tap on the image to see the template preview.</p>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">

        <!-- Cards Loop -->
        <% allSamples.forEach((sample, sampleIndex) => { %>
          <!-- Card Container -->
          <div
            class="group relative bg-slate-900 border border-slate-800 rounded-2xl md:rounded-3xl overflow-hidden hover:border-slate-600 transition-all duration-300 hover:shadow-2xl hover:shadow-indigo-500/10 flex flex-col h-full">

            <!-- Image Section -->
            <div class="relative h-48 md:h-56 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent  opacity-60">
              </div>
              <a href="<%= sample.webUrl %>"
                class="block w-full h-full"
                <%= sampleIndex < 3 ? 'data-top-template-preview-link="true"' : '' %>>
                <img src="<%= getOptimizedCloudinaryUrl(sample.imageUrl.url, "card") %>"
                  srcset="<%= getResponsiveCloudinarySrcSet(sample.imageUrl.url, 'card') %>"
                  sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                  alt="<%= sample.webName %>"
                  loading="lazy" decoding="async" fetchpriority="low"
                  class="w-full h-full object-cover transform group-hover:scale-105 transition duration-700 ease-in-out">
              </a>
              <div class="absolute bottom-4 left-1 right-4 w-full flex items-center justify-between ">
                <a
                  href="<%= sample.webUrl %>"
                  aria-label="Open live preview for <%= sample.webName %>"
                  class="ml-1 px-3 py-1 bg-white/10 backdrop-blur-md border border-white/20 text-white text-[10px] font-bold rounded-lg uppercase tracking-wider">
                  Live Preview
                </a>

              </div>
            </div>

            <!-- Content Section -->
            <div class="p-4 md:p-6 flex flex-col flex-grow">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg md:text-xl font-bold text-slate-100 group-hover:text-indigo-400 transition-colors">
                  <%= sample.webName %>
                </h3>
              </div>
              <% if(currUser && currUser.isAdmin) { %>
                <p class="text-xs text-indigo-300 mb-2">Priority: <%= Number.isFinite(sample.priority) ? sample.priority : 0 %></p>
              <% } %>
              <p class="text-slate-400 text-xs md:text-sm mb-4 md:mb-6 line-clamp-2 flex-grow">
                <%= sample.description %>
              </p>
              <!-- Action Buttons -->
              <div class="grid grid-cols-2 gap-3 mt-auto">
                <!-- Preview Button -->
                <a href="/web/purchase/permanent/<%= sample.id %>" target="_blank" rel="noopener noreferrer"
                  class="flex items-center justify-center px-4 py-2 md:py-2.5 rounded-xl border border-slate-700 text-slate-300 font-semibold text-xs md:text-sm hover:bg-slate-800 hover:text-white transition active:scale-95">
                  Permanent link
                </a>

                <!-- Purchase Button -->
                <a href="/web/purchase/temporary/<%= sample.id %>"
                  class="submitBtnLink flex items-center justify-center px-4 py-2 md:py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-xs md:text-sm hover:bg-indigo-500 shadow-lg shadow-indigo-600/20 transition active:scale-95">
                  Make Link
                </a>
                <% if(currUser && currUser.isAdmin) { %>
                  <a href="/web/template/<%= sample.id %>/edit"
                    class="col-span-2 flex items-center justify-center px-4 py-2 md:py-2.5 rounded-xl border border-amber-500/40 bg-amber-500/10 text-amber-200 font-semibold text-xs md:text-sm hover:bg-amber-500/20 transition active:scale-95">
                    Edit Template
                  </a>
                <% } %>
              </div>
            </div>
          </div>
          <% }) %>
      </div>
    </main>

    <script defer src="/homeCollection.js?v=<%= assetVersion %>"></script>

  </div>
