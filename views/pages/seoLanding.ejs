<% layout("/layouts/boilerplate") %>

<div class="bg-[#0B1120] text-slate-200 min-h-screen w-full">
  <main class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-14">
    <header class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 md:p-10">
      <p class="text-xs uppercase tracking-[0.18em] text-indigo-300 font-semibold">VishLink Guide</p>
      <h1 class="mt-3 text-3xl md:text-4xl font-extrabold text-white leading-tight"><%= pageData.heading %></h1>
      <% (Array.isArray(pageData.intro) ? pageData.intro : []).forEach((line) => { %>
        <p class="mt-4 text-slate-300 leading-relaxed"><%= line %></p>
      <% }) %>
    </header>

    <% if (Array.isArray(pageData.categoryLinks) && pageData.categoryLinks.length) { %>
      <section class="mt-8 rounded-3xl border border-slate-800 bg-slate-900/50 p-6 md:p-8">
        <h2 class="text-xl md:text-2xl font-bold text-white">Explore Related Pages</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <% pageData.categoryLinks.forEach((item) => { %>
            <a href="<%= item.href %>" class="rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-4 py-3 text-sm font-semibold text-indigo-200 hover:bg-indigo-500/20 transition">
              <%= item.label %>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (Array.isArray(pageData.faqs) && pageData.faqs.length) { %>
      <section class="mt-8 rounded-3xl border border-slate-800 bg-slate-900/40 p-6 md:p-8">
        <h2 class="text-xl md:text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <div class="mt-4 space-y-3">
          <% pageData.faqs.forEach((faq) => { %>
            <details class="rounded-xl border border-slate-700/80 bg-slate-900/40 p-4">
              <summary class="cursor-pointer text-sm md:text-base font-semibold text-slate-100">
                <%= faq.question %>
              </summary>
              <p class="mt-3 text-sm text-slate-300 leading-relaxed"><%= faq.answer %></p>
            </details>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>
</div>
