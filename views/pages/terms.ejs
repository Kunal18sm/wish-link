<% layout("layouts/boilerplate") %>

<style>
  body {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, system-ui, sans-serif;
    background-color: #0B1120;
    scroll-behavior: smooth;
  }

  .glass-card {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .gradient-text {
    background: linear-gradient(135deg, #818cf8 0%, #34d399 100%);
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bg-mesh {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    width: 600px;
    height: 600px;
    background: rgba(79, 70, 229, 0.1);
    filter: blur(120px);
    border-radius: 50%;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #0B1120;
  }

  ::-webkit-scrollbar-thumb {
    background: #1e293b;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #334155;
  }

  html[data-theme="light"] body {
    background-color: #fff7f5 !important;
    color: #5a3245 !important;
  }

  html[data-theme="light"] .glass-card {
    background: #fff4f2 !important;
    border: 1px solid rgba(225, 29, 72, 0.18) !important;
    box-shadow: 0 14px 30px -18px rgba(190, 24, 93, 0.24);
  }

  html[data-theme="light"] .gradient-text {
    background: linear-gradient(135deg, #e11d48 0%, #f97316 100%);
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  html[data-theme="light"] .bg-mesh .blob {
    background: rgba(244, 63, 94, 0.14) !important;
  }

  html[data-theme="light"] .bg-mesh .blob[style*="background"] {
    background: rgba(251, 146, 60, 0.12) !important;
  }

  html[data-theme="light"] .text-white {
    color: #4b2436 !important;
  }

  html[data-theme="light"] .text-slate-400,
  html[data-theme="light"] .text-slate-500,
  html[data-theme="light"] .text-slate-600 {
    color: #8c5d70 !important;
  }

  html[data-theme="light"] .bg-indigo-500\/10,
  html[data-theme="light"] .bg-indigo-500\/20 {
    background: rgba(244, 63, 94, 0.1) !important;
  }

  html[data-theme="light"] .border-indigo-500\/20 {
    border-color: rgba(225, 29, 72, 0.28) !important;
  }

  html[data-theme="light"] .text-indigo-400 {
    color: #be185d !important;
  }

  html[data-theme="light"] .bg-indigo-600 {
    background-color: #f43f5e !important;
  }

  html[data-theme="light"] .hover\:bg-indigo-500:hover {
    background-color: #e11d48 !important;
  }

  html[data-theme="light"] ::-webkit-scrollbar-track {
    background: #fff1ef;
  }

  html[data-theme="light"] ::-webkit-scrollbar-thumb {
    background: #f9a8b9;
  }

  html[data-theme="light"] ::-webkit-scrollbar-thumb:hover {
    background: #fb7185;
  }
</style>
</head>

<body class="text-slate-300 antialiased selection:bg-indigo-500/30">

  <!-- Background Decoration -->
  <div class="bg-mesh">
    <div class="blob" style="top: -5%; left: 20%;"></div>
    <div class="blob" style="bottom: -5%; right: 10%; background: rgba(16, 185, 129, 0.05);"></div>
  </div>

  <main class="max-w-4xl mx-auto px-6 pt-24 pb-32">

    <!-- Header -->
