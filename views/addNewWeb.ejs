<% layout("/layouts/boilerplate") %>

<!-- Background & Typography Setup -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
  
  .font-body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  
  /* Custom form styles */
  .form-input {
    background-color: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(71, 85, 105, 0.5);
    transition: all 0.3s ease;
  }
  .form-input:focus {
    background-color: rgba(30, 41, 59, 0.8);
    border-color: #6366f1; /* Indigo-500 */
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
  }
</style>

<!-- Main Wrapper -->
<div class="bg-[#0B1120] text-slate-200 min-h-screen flex flex-col font-body relative overflow-x-hidden">

    <!-- Background Ambient Glow -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[120px] mix-blend-screen"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px] bg-emerald-500/10 rounded-full blur-[120px] mix-blend-screen"></div>
    </div>

    <main class="flex-grow flex items-center justify-center px-4 md:px-6 py-12">
        <div class="max-w-5xl w-full grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">

            <!-- Left Side: Title & Info -->
            <div class="lg:col-span-2 lg:sticky lg:top-24 pt-8 text-center lg:text-left">
                <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight text-white">
                    Let's Upload <br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">New Websites</span>
                </h1>
                <p class="text-slate-400 text-lg leading-relaxed mb-8">
                    Add a new template to the collection. Make sure to select the appropriate categories so users can find it easily.
                </p>
                
                <!-- Decorative Elements -->
                <div class="hidden lg:block relative h-64 w-full rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/50 backdrop-blur-sm p-6">
                    <div class="absolute inset-0 bg-grid-slate-700/[0.2] [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.5))]"></div>
                    <div class="relative z-10 flex items-center gap-3 mb-4">
                        <div class="w-3 h-3 rounded-full bg-red-500"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500"></div>
                    </div>
                    <div class="space-y-2">
                        <div class="h-2 w-3/4 bg-slate-700 rounded animate-pulse"></div>
                        <div class="h-2 w-1/2 bg-slate-700 rounded animate-pulse"></div>
                        <div class="h-2 w-full bg-slate-700 rounded animate-pulse"></div>
                    </div>
                </div>
            </div>

            <!-- Right Side: MAIN FORM -->
            <div class="lg:col-span-3 bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 md:p-8 rounded-3xl shadow-2xl relative">
                <!-- Form Glow Border -->
                <div class="absolute inset-0 rounded-3xl ring-1 ring-inset ring-white/10 pointer-events-none"></div>

                <form id="AddNewForm" action="/web/new" method="POST" class="space-y-6" enctype="multipart/form-data">
                    
                    <!-- Basic Info Section -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Website Name</label>
                            <input name="formData[webName]" type="text" placeholder="e.g. Birthday Bubble"
                                class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600" required>
                        </div>
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Website Url</label>
                            <input name="formData[webUrl]" type="url" placeholder="https://..."
                                class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600" required>
                        </div>
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Thumbnail</label>
                            <input name="imageUrl" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
                                class="w-full px-4 py-2.5 rounded-xl form-input text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-500/10 file:text-indigo-400 hover:file:bg-indigo-500/20" required>
                        </div>

                        <!-- 💲💲 Prices 💲💲 -->

                        <div class="col-span-1">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Price For Temporary (₹)</label>
                            <input name="formData[priceForTemporary]" type="number" placeholder="49"
                                class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600" required>
                        </div>
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Price For Permanent (₹)</label>
                            <input name="formData[priceForPermanent]" type="number" placeholder="49"
                                class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600" required>
                        </div>

                        <div class="col-span-full">
                             <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Images Needed (Count)</label>
                             <input name="formData[imageNeeded]" type="number" placeholder="How many images does user need to upload?"
                                 class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600" required>
                        </div>
                        <!-- Article Content Section (SEO / AdSense Safe) -->
                        <div class="pt-4 border-t border-slate-800">
                        <h3 class="text-lg font-bold text-white mb-2">
                            Article Content (Optional but Recommended)
                        </h3>

                        <p class="text-sm text-slate-500 mb-4">
                            This content will appear above the purchase form. Helps with SEO & AdSense approval.
                        </p>

                        <!-- Article Title -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">
                            Article Title
                            </label>
                            <input 
                            name="formData[title]" 
                            type="text" 
                            placeholder="e.g. Why Digital Surprise Websites Are Trending"
                            class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600">
                        </div>

                        <!-- Article Content -->
                        <div>
                            <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">
                            Article Content
                            </label>
                            <textarea 
                            name="formData[content]" 
                            rows="6"
                            placeholder="Write 150–300 words explaining this template, its use case, and benefits..."
                            class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600 resize-none"></textarea>

                            <p class="text-xs text-slate-500 mt-2 ml-1">
                            Tip: 150+ words is ideal. Avoid keyword stuffing.
                            </p>
                        </div>
                        </div>

                    </div>

                    <!-- Categories / Tags Section (NEW) -->
                    <div class="pt-4 border-t border-slate-800">
                        <label class="block text-sm font-semibold mb-3 text-slate-300 ml-1">Select Categories</label>
                        <div class="flex flex-wrap gap-2 md:gap-3">
                            <% const categories = ["All","Free","Birthday", "Valentine's", "Sorry", "Girlfriend", "Family", "Funny", "Males", "Females", "Single", "Couple", "Anniversary", "Wedding", "Best Friend", "Parents", "Festival", "New Year", "Christmas", "Diwali", "Eid", "Holi"]; %>
                            
                            <% categories.forEach(tag => { %>
                                <label class="cursor-pointer group">
                                    <!-- Hidden checkbox, using name="listing[category]" assuming schema accepts array -->
                                    <input type="checkbox" name="formData[category][]" value="<%= tag.toLowerCase() %>" class="peer sr-only">
                                    
                                    <!-- Custom Styled Tag -->
                                    <span class="inline-block px-4 py-2 rounded-xl border border-slate-700 bg-slate-800/50 text-slate-400 text-sm font-medium transition-all duration-200 
                                               group-hover:border-slate-500 group-hover:bg-slate-800 
                                               peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-500 peer-checked:shadow-[0_0_15px_rgba(99,102,241,0.4)]
                                               peer-focus:ring-2 peer-focus:ring-indigo-500/50 select-none">
                                        <%= tag %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                        <p class="text-xs text-slate-500 mt-2 ml-1">Select all that apply to this template.</p>
                    </div>

                    <!-- Description Section -->
                    <div>
                        <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1">Short Description</label>
                        <textarea name="formData[description]" rows="4" placeholder="Tell more about this project..."
                            class="w-full px-4 py-3 rounded-xl form-input text-white focus:outline-none placeholder-slate-600 resize-none" required></textarea>
                    </div>

                    <!-- Submit Button -->
                    <button id="submitBtn" type="submit"
                        class="w-full bg-gradient-to-r from-indigo-600 to-violet-600 py-4 rounded-xl font-bold text-white shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/40 hover:scale-[1.01] transition-all duration-300 active:scale-[0.99] mt-4">
                        Upload New Website
                    </button>

                </form>
            </div>
        </div>
    </main>

    <script>
        const form = document.getElementById("AddNewForm");
        const btn = document.getElementById("submitBtn");

        function getTargetWidth() {
            if (window.innerWidth <= 640) return 480;
            if (window.innerWidth <= 1024) return 768;
            return 1200;
        }

        function loadImage(file) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                const objectUrl = URL.createObjectURL(file);
                img.onload = () => {
                    URL.revokeObjectURL(objectUrl);
                    resolve(img);
                };
                img.onerror = () => {
                    URL.revokeObjectURL(objectUrl);
                    reject(new Error("Failed to load image"));
                };
                img.src = objectUrl;
            });
        }

        async function optimizeImageFile(file) {
            if (!file || !String(file.type || "").startsWith("image/")) return file;

            const img = await loadImage(file);
            const maxWidth = getTargetWidth();
            const scale = Math.min(1, maxWidth / img.width);
            const width = Math.round(img.width * scale);
            const height = Math.round(img.height * scale);

            const canvas = document.createElement("canvas");
            canvas.width = width;
            canvas.height = height;
            const context = canvas.getContext("2d");
            context.drawImage(img, 0, 0, width, height);

            const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.8));
            if (!blob || blob.size >= file.size) return file;

            const safeName = file.name.replace(/\.[^/.]+$/, "");
            return new File([blob], `${safeName}.webp`, { type: "image/webp", lastModified: Date.now() });
        }

        async function optimizeInputFiles(inputElement) {
            if (!inputElement || !inputElement.files || !inputElement.files.length) return;
            if (typeof DataTransfer === "undefined") return;
            const optimized = await Promise.all(Array.from(inputElement.files).map(optimizeImageFile));
            const dataTransfer = new DataTransfer();
            optimized.forEach((file) => dataTransfer.items.add(file));
            inputElement.files = dataTransfer.files;
        }
        
        form.addEventListener("submit", async function (event) {
            if (form.dataset.optimizedSubmit === "true") return;
            event.preventDefault();

            btn.disabled = true;
            btn.innerHTML = `
                <span class="flex items-center justify-center gap-2">
                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Optimizing images...
                </span>
            `;
            btn.classList.add('opacity-75', 'cursor-not-allowed');

            try {
                await optimizeInputFiles(form.querySelector('input[name="imageUrl"]'));
            } catch (_err) {
                // If optimization fails, original image will still be uploaded.
            }

            form.dataset.optimizedSubmit = "true";
            btn.innerHTML = `
                <span class="flex items-center justify-center gap-2">
                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Uploading...
                </span>
            `;
            form.submit();
        });
    </script>
</div>
