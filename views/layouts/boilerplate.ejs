                                        </div>
                                        <span class="text-[9px] mt-2 font-bold text-slate-400">+<%= dayReward.credits %></span>
                                        <span class="text-[8px] mt-1 font-bold text-slate-500 uppercase">Locked</span>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>

                        <p id="dailyRewardFeedback" class="mt-3 text-center text-xs text-rose-300 hidden"></p>
