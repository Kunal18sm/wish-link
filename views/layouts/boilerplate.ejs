                <% const dayOrder = ["mon","tue","wed","thu","fri","sat","sun"]; %>
                <% const normalizedTodayIndex = Math.max(0, dayOrder.indexOf(dailyCreditReward.todayKey)); %>
                <% const todayKey = dayOrder[normalizedTodayIndex] || "mon"; %>
                <% const progressPercent = Math.max(0, Math.round((normalizedTodayIndex / 7) * 100)); %>
                <div id="dailyRewardStack" data-date-key="<%= todayCreditDateKey %>" class="fixed inset-0 px-3 flex justify-center items-start pointer-events-auto" style="z-index:45;padding-top:74px;">
                    <div id="dailyRewardModal"
                        class="rounded-2xl px-4 pb-4 pt-3 text-white relative overflow-hidden pointer-events-auto">
                        <div class="absolute -top-12 -right-12 w-24 h-24 bg-yellow-500/10 blur-3xl rounded-full pointer-events-none"></div>

                        <div class="flex mt-8 mb-8 justify-between items-center mb-4 relative">
                            <div>
                                <h2 class="text-xl font-bold text-yellow-400">Daily Gifts</h2>
                                <p class="text-[10px] text-slate-300 uppercase tracking-widest">Claim your rewards</p>
                            </div>
                            <div class="bg-slate-950/45 px-3 py-1.5 rounded-2xl border border-yellow-300/20 flex items-center gap-2">
