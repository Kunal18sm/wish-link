<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../includes/seoHead.ejs") %>
    <script>
        (function () {
            try {
                var serverPalette = <%- JSON.stringify(userLightPalette || "blue") %>;
                if (serverPalette !== "blue" && serverPalette !== "pink") serverPalette = "blue";
                var t = localStorage.getItem("vishlink-theme");
                if (t !== "light" && t !== "dark") t = "dark";
                var lp = localStorage.getItem("vishlink-light-palette");
                if (lp !== "blue" && lp !== "pink") lp = serverPalette;
                document.documentElement.setAttribute("data-theme", t);
                document.documentElement.setAttribute("data-light-palette", lp);
                document.documentElement.setAttribute("data-default-light-palette", serverPalette);
                window.__VISHLINK_DEFAULT_LIGHT_PALETTE = serverPalette;
            } catch (_err) {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.setAttribute("data-light-palette", "blue");
                document.documentElement.setAttribute("data-default-light-palette", "blue");
                window.__VISHLINK_DEFAULT_LIGHT_PALETTE = "blue";
            }
        })();
    </script>

    <% const normalizedDesignCssVariant = (typeof designCssVariant === "string" && designCssVariant) ? designCssVariant : "full"; %>
    <% const useLiteDesignCss = normalizedDesignCssVariant === "lite"; %>
    <% const loadDesignCss = (typeof disableDesignCss === "boolean") ? !disableDesignCss : true; %>
    <link rel="stylesheet" href="/output.css?v=<%= assetVersion %>">
    <% if (loadDesignCss) { %>
        <link rel="stylesheet" href="/design.css?v=<%= assetVersion %>" media="print" onload="this.media='all'">
    <% } %>
    <% if (loadDesignCss && useLiteDesignCss) { %>
        <link rel="stylesheet" href="/homeCollectionLite.css?v=<%= assetVersion %>" media="print" onload="this.media='all'">
    <% } %>
    <noscript>
        <% if (loadDesignCss) { %>
            <link rel="stylesheet" href="/design.css?v=<%= assetVersion %>">
        <% } %>
        <% if (loadDesignCss && useLiteDesignCss) { %>
            <link rel="stylesheet" href="/homeCollectionLite.css?v=<%= assetVersion %>">
        <% } %>
    </noscript>
    <% if (enableAnalytics) { %>
    <!-- Google Analytics (lazy loaded after page becomes idle) -->
    <script>
        (function () {
            var gaLoaded = false;

            function loadGa() {
                if (gaLoaded) return;
                gaLoaded = true;

                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
                window.gtag("js", new Date());
                window.gtag("config", "G-L0F12E1ENT");

                var gaScript = document.createElement("script");
                gaScript.async = true;
                gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-L0F12E1ENT";
                document.head.appendChild(gaScript);
            }

            window.addEventListener("load", function () {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadGa, { timeout: 2500 });
                } else {
                    setTimeout(loadGa, 1200);
                }
            }, { once: true });
        })();
    </script>
    <% } %>
</head>

<body class="bg-[#020617] text-slate-200 flex flex-col <%= (typeof chatLayout !== 'undefined' && chatLayout) ? 'h-dvh overflow-hidden' : 'min-h-screen' %>">

