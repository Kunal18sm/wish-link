                                </div>
                                <span id="balance" class="text-sm font-bold tracking-tight"><%= Number(userCredits || 0).toLocaleString("en-IN") %></span>
                            </div>
                        </div>

                        <div class="reward-grid mb-5 relative">
                            <% rewardDays.forEach((dayReward, idx) => { const isToday = dayReward.key === todayKey; const isClaimed = normalizedTodayIndex > idx; const isLocked = normalizedTodayIndex < idx; %>
                                <div class="day-box rounded-2xl p-3 flex flex-col items-center justify-center text-center <%= isToday ? 'active-day cursor-pointer group' : '' %> <%= isClaimed ? 'claimed' : '' %> <%= isLocked ? 'locked opacity-60' : '' %>"
                                    <%= isToday ? `id="dailyRewardActiveDay" data-day-label="${dayReward.label}"` : "" %>>
                                    <span class="text-[10px] font-semibold <%= isToday ? 'text-yellow-300' : 'text-slate-300' %> mb-2"><%= dayReward.label %></span>
                                    <% if (isClaimed) { %>
                                        <img src="<%= checkIconPath %>" alt="claimed" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6">
                                        <span class="text-[9px] mt-2 font-bold text-green-400 uppercase">Done</span>
                                    <% } else if (isToday) { %>
