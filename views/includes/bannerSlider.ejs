<% const rawSlides = Array.isArray(bannerSlides) ? bannerSlides : []; %>
<% const slides = rawSlides.filter((slide) => slide && String(slide.imageUrl || "").trim()); %>
<% const toneClasses = ["bg-purple-900/20", "bg-indigo-900/20", "bg-purple-900/20"]; %>

<% if (slides.length) { %>
  <div class="w-full max-w-4xl mb-0" data-banner-carousel>
    <div class="relative w-full rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950 group">
      <div data-banner-slider class="flex transition-transform duration-700 ease-in-out">
        <% slides.forEach((slide, slideIndex) => { %>
          <% const slideData = slide || {}; %>
          <% const slideTitle = String(slideData.title || "").trim() || ("Banner Slide " + (slideIndex + 1)); %>
          <% const slideImage = String(slideData.imageUrl || "").trim(); %>
          <% const slideLink = String(slideData.linkUrl || "/").trim() || "/"; %>
          <% const slideAlt = String(slideData.altText || "").trim() || slideTitle; %>
          <% const optimizedImage = typeof getOptimizedCloudinaryUrl === "function" ? getOptimizedCloudinaryUrl(slideImage, "banner") : slideImage; %>
          <% const responsiveSrcSet = typeof getResponsiveCloudinarySrcSet === "function" ? getResponsiveCloudinarySrcSet(slideImage, "banner") : ""; %>
          <div class="min-w-full relative <%= toneClasses[slideIndex % toneClasses.length] %>">
            <a href="<%= slideLink %>" class="relative block w-full h-[200px] sm:h-[250px] md:h-[330px] lg:h-[400px] overflow-hidden">
              <img
                src="<%= optimizedImage %>"
                srcset="<%= responsiveSrcSet %>"
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 84vw, 840px"
                loading="<%= slideIndex === 0 ? 'eager' : 'lazy' %>"
                decoding="async"
                fetchpriority="<%= slideIndex === 0 ? 'high' : 'low' %>"
                class="relative z-10 w-full h-full object-contain p-2 sm:p-3 md:p-4"
                alt="<%= slideAlt %>">
              <div class="absolute inset-0 z-20 bg-gradient-to-t from-black/90 via-black/45 to-black/20"></div>
              <div class="absolute inset-x-0 bottom-2 z-30 flex items-center justify-center px-2">
                <p class="px-3 py-1 text-sm md:text-base font-semibold text-white bg-black/55 rounded-md shadow-lg">
                  <%= slideTitle %>
                </p>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>

    <% if (slides.length > 1) { %>
      <div class="mt-2 mb-1 flex justify-center gap-1.5">
        <% slides.forEach((_slide, slideIndex) => { %>
          <button
            type="button"
            class="banner-dot"
            data-slide-index="<%= slideIndex %>"
            aria-label="Show banner slide <%= slideIndex + 1 %>">
            <span class="banner-dot-indicator"></span>
          </button>
        <% }) %>
      </div>
    <% } %>
  </div>
<% } %>
