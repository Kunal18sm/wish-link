<% const isUserAdmin = (typeof currUser !== "undefined" && currUser && currUser.isAdmin); %>
<% if (!isUserAdmin) { %>
  <!-- Platform Migration Announcement Popup Modal -->
  <div id="migrationModalBackdrop" style="position: fixed; inset: 0; background: rgba(2, 6, 23, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 16px; animation: migrationFadeIn 0.3s ease-out;">
    <div style="background: linear-gradient(145deg, #0f172a, #1e1b2e); border: 1.5px solid rgba(225, 91, 112, 0.4); border-radius: 24px; padding: 28px 24px; max-width: 480px; width: 100%; box-shadow: 0 25px 50px -12px rgba(225, 91, 112, 0.25), 0 0 30px rgba(15, 23, 42, 0.9); text-align: center; color: #ffffff; position: relative; font-family: system-ui, -apple-system, sans-serif;">
      
      <!-- Close / Dismiss button -->
      <button id="migrationModalCloseBtn" type="button" aria-label="Close migration notice" style="position: absolute; top: 14px; right: 14px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #cbd5e1; border-radius: 50%; width: 32px; height: 32px; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">&times;</button>

      <!-- Animated Icon -->
      <div style="width: 64px; height: 64px; margin: 0 auto 16px auto; background: linear-gradient(135deg, #e15b70, #f48a9b); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 10px 25px rgba(225, 91, 112, 0.4);">
        🚀
      </div>

      <!-- Badge Tag -->
      <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(225, 91, 112, 0.15); color: #f48a9b; border: 1px solid rgba(225, 91, 112, 0.3); padding: 4px 14px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
        ✨ Important Platform Upgrade
      </div>

      <!-- Header Title -->
      <h2 style="font-size: 22px; font-weight: 800; margin: 0 0 10px 0; color: #ffffff; line-height: 1.3;">
        We Have Moved to a New Platform!
      </h2>

      <!-- Description -->
      <p style="font-size: 13px; color: #94a3b8; line-height: 1.6; margin: 0 0 22px 0;">
        We have upgraded to a brand new website with faster speeds, new 3D templates, instant link creation, and enhanced customization! Please visit our new platform to create your wishing web pages.
      </p>

      <!-- Main Action Link Button -->
      <a href="https://vishlink.vercel.app/" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: linear-gradient(135deg, #e15b70, #d4485e); color: #ffffff; font-weight: 800; font-size: 14px; padding: 14px 20px; border-radius: 16px; text-decoration: none; box-shadow: 0 10px 20px -5px rgba(225, 91, 112, 0.5); transition: transform 0.2s, box-shadow 0.2s;">
        <span>Launch New Website (vishlink.vercel.app)</span>
        <span style="font-size: 16px;">➔</span>
      </a>

      <!-- Secondary URL note -->
      <p style="font-size: 11px; color: #64748b; margin: 12px 0 0 0;">
        Official URL: <strong style="color: #cbd5e1;">https://vishlink.vercel.app/</strong>
      </p>
    </div>
  </div>

  <style>
    @keyframes migrationFadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>

  <script>
    (function() {
      function openMigrationPopup(e) {
        var modal = document.getElementById('migrationModalBackdrop');
        if (modal) {
          modal.style.display = 'flex';
          if (e && e.preventDefault) {
            var target = e.target.closest('a');
            if (!target || !target.href || !target.href.includes('vishlink.vercel.app')) {
              e.preventDefault();
            }
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        var modal = document.getElementById('migrationModalBackdrop');
        var closeBtn = document.getElementById('migrationModalCloseBtn');

        if (closeBtn && modal) {
          closeBtn.addEventListener('click', function() {
            modal.style.display = 'none';
          });
        }

        // Intercept clicks on template links, customize buttons, purchase links for normal users
        document.addEventListener('click', function(e) {
          var target = e.target.closest('a, button, .template-card, [data-template-id], [href*="template"], [href*="purchase"], [href*="addNewWeb"], [href*="collection"]');
          if (target && !target.closest('#migrationModalBackdrop') && !target.closest('[href*="vishlink.vercel.app"]') && !target.closest('a[href*="admin"]')) {
            openMigrationPopup(e);
          }
        });
      });
    })();
  </script>
<% } %>
