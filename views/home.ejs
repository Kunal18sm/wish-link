<% layout("/layouts/boilerplate") %>

  <body class="bg-[#0f172a] text-slate-200 antialiased">

    <header class="max-w-6xl mx-auto px-6 py-20 text-center">
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6">
        Wish your loved ones and<br> <span class="gradient-text">Make their day special.</span>
      </h1>
      <p class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-10">
        Explore premium and high-quality website for heartfelt wishes.
      </p>
      <div class="flex flex-col md:flex-row justify-center gap-4">
        <input disabled type="text" placeholder="A message for someone special or…"
          class="bg-slate-800 border border-slate-700 px-6 py-3 rounded-xl w-full md:w-96 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <button
          class="bg-indigo-600 px-8 py-3 rounded-xl font-bold hover:shadow-lg hover:shadow-indigo-500/20 transition">Send Smiles</button>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-3xl font-bold">Featured Websites</h2>
          <p class="text-slate-500 mt-2">Our most popular designs this week</p>
        </div>
        <a href="#" class="text-indigo-400 font-semibold hover:underline"></a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- cards  -->
        <% for(let sample of allSamples) { %>
          <l1>
            <div class="glass-effect rounded-2xl overflow-hidden group hover:scale-[1.02] transition duration-300">
              <div class="h-48 overflow-hidden">
                <img src=<%=sample.imageUrl.url %>
                alt="SaaS Dashboard" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2">
                  <%= sample.webName %>
                </h3>
                <p class="text-slate-400 text-sm mb-4">
                  <%= sample.description %>
                </p>
                <div class="flex justify-between items-center">
                  <span class="text-indigo-400 font-bold">₹<%= sample.price %></span>
                  <div>
                    <a id="submitBtn" href="/web/purchase/<%= sample.id %>">
                      <button 
                        class=" text-xs font-semibold bg-slate-800 px-3 py-1 rounded-md border border-slate-700">Buy
                      </button>
                    </a>
                    <a href="<%=sample.webUrl %>" target="_blank" rel="noopener noreferrer">
                      <button 
                        class="text-xs font-semibold bg-slate-800 px-3 py-1 rounded-md border border-slate-700">Preview
                      </button>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </l1>
          <% } %>

      </div>
    </main>

    <script>
      const btn = document.getElementById("submitBtn");
      btn.addEventListener("click", function () {
        btn.disabled = true;
        btn.innerText = "go.";
      });
    </script>

  </body>