<% layout("/layouts/boilerplate") %>

  <style>
    /* Custom Scrollbar */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Smooth snap scrolling */
    .snap-x {
      scroll-snap-type: x mandatory;
    }

    .snap-start {
      scroll-snap-align: start;
    }
  </style>

  <div class="home-page bg-[#0B1120] text-slate-200 antialiased relative min-h-screen w-full selection:bg-indigo-500/30">

    <!-- Background Glows -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
      <div
        class="absolute top-[-10%] left-[-10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-indigo-600/15 rounded-full blur-[100px] animate-pulse">
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-emerald-500/10 rounded-full blur-[100px]">
      </div>
    </div>

    <!-- Header Section -->
    <header class="relative max-w-7xl mx-auto px-4 md:px-6 pt-8 pb-10 text-center flex flex-col items-center">
      <!-- 2. Optimized Slidable Image Banner -->
      <%- include("includes/bannerSlider", { bannerSlides }) %>

    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 md:px-6 mb-20">
      <% const websiteTopTemplates = Array.isArray(topTemplates) ? topTemplates : (Array.isArray(allSamples) ? allSamples.slice(0, 10) : []); %>
      <% const homeTopPhotoFrameTemplates = Array.isArray(topPhotoFrameTemplates) ? topPhotoFrameTemplates.slice(0, 4) : []; %>
      <% const templateCoinIconPath = `/assets/icons/coin.svg?v=${assetVersion}`; %>

      <div class="flex items-center justify-between mb-2 border-b border-slate-800/60 pb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-white">Top Website Templates</h2>
          <p class="text-slate-500 text-sm mt-1">Scroll or swipe to see more</p>
        </div>

        <!-- Desktop Nav Controls -->
        <div class="hidden md:flex gap-3">
          <button id="prevBtn"
            type="button"
            aria-label="Scroll templates to previous cards"
            class="p-3 min-w-[44px] min-h-[44px] rounded-full bg-slate-900 border border-slate-700 text-slate-200 hover:text-white hover:border-indigo-500 transition-all active:scale-90">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button id="nextBtn"
            type="button"
            aria-label="Scroll templates to next cards"
            class="p-3 min-w-[44px] min-h-[44px] rounded-full bg-slate-900 border border-slate-700 text-slate-200 hover:text-white hover:border-indigo-500 transition-all active:scale-90">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <section class="mb-6">
        
        <div class="w-full max-w-5xl mx-auto overflow-hidden">
          <div class="overflow-x-auto no-scrollbar py-2">
            <div class="flex flex-nowrap gap-2 px-4 w-max mx-auto">
              <% const categories=["All","Free", "Birthday" , "Valentine's" , "Sorry" , "Family" , "Couple"
                , "Anniversary" , "Wedding" , "Best Friend" , "Festival" , "New Year" ]; %>
                <% categories.forEach(tag=> { %>
                  <a href="/category/<%= tag.toLowerCase() %>"
                    class="px-4 py-2.5 min-h-[44px] rounded-full bg-slate-900/40 border border-slate-700 text-slate-300 text-[11px] md:text-xs font-medium hover:border-indigo-500/40 hover:text-indigo-300 transition-all whitespace-nowrap inline-flex items-center">
                    <%= tag %>
                  </a>
                <% }) %>
            </div>
          </div>
        </div>
      </section>

      <div class="mb-8 flex items-center justify-center gap-2 text-xs text-slate-500">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <p class="text-emerald-500">Tap on the image to see the template preview.</p>
      </div>

      <!-- HORIZONTAL SCROLL CONTAINER -->
      <div class="relative scroll-container">
        <!-- Gradient Fades (Desktop only) -->
        <div
          class="hidden lg:block absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-[#0B1120] to-transparent z-10 pointer-events-none">
        </div>
        <div
          class="hidden lg:block absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-[#0B1120] to-transparent z-10 pointer-events-none">
        </div>

        <div id="templateScroller" class="flex overflow-x-auto no-scrollbar gap-4 md:gap-6 pb-10 snap-x snap-mandatory"
          style="-webkit-overflow-scrolling: touch;">

          <% websiteTopTemplates.forEach((sample, sampleIndex) => { %>
            <div class="flex-none w-[85vw] sm:w-[45vw] md:w-[40vw] lg:w-[30vw] xl:w-[24vw] snap-start group">
              <div
                class="bg-slate-900/50 border border-slate-800 rounded-3xl overflow-hidden transition-all duration-500 hover:border-indigo-500/50 hover:shadow-[0_0_30px_rgba(99,102,241,0.1)] flex flex-col h-full backdrop-blur-sm">

                <!-- Image -->
                <div class="relative h-48 md:h-56 overflow-hidden">
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent  opacity-60">
                  </div>
                  <a href="<%= sample.webUrl %>"
                    class="block w-full h-full"
                    <%= sampleIndex < 3 ? 'data-top-template-preview-link="true"' : '' %>>
                    <img src="<%= getOptimizedCloudinaryUrl(sample.imageUrl.url, "card") %>"
                      srcset="<%= getResponsiveCloudinarySrcSet(sample.imageUrl.url, 'card') %>"
                      sizes="(max-width: 640px) 85vw, (max-width: 1024px) 45vw, 30vw"
                      alt="<%= sample.webName %>"
                      loading="lazy" decoding="async" fetchpriority="low"
                      class="w-full h-full object-cover transform group-hover:scale-105 transition duration-700 ease-in-out">
                  </a>
                  <div class="absolute bottom-4 left-1 right-4 w-full flex items-center justify-between ">
                    <a
                      href="<%= sample.webUrl %>"
                      aria-label="Open live preview for <%= sample.webName %>"
                      class="ml-1 px-3 py-1 bg-white/10 backdrop-blur-md border border-white/20 text-white text-[10px] font-bold rounded-lg uppercase tracking-wider">
                      Live Preview
                    </a>

                    <% if(sample.priceForPermanent && sample.priceForTemporary===0 ) { %>
                      <span
                        class="mr-2 px-3 py-1 bg-emerald-500 text-white-400 border border-emerald-500/20 text-[10px] font-medium rounded-md tracking-wide">
                        Free
                      </span>
                      <% } %>
                  </div>
                </div>

                <!-- Info -->
                <div class="p-5 md:p-6 flex flex-col flex-grow">
                  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors">
                    <%= sample.webName %>
                  </h3>
                  <% if(currUser && currUser.isAdmin) { %>
                    <p class="text-xs text-indigo-300 mb-2">Priority: <%= Number.isFinite(sample.priority) ? sample.priority : 0 %></p>
                  <% } %>
                  <p class="text-slate-400 text-sm line-clamp-2 mb-6 h-10">
                    <%= sample.description %>
                  </p>
                  <% const rawCoinPrice = Number(sample.purchaseCredits); %>
                  <% const coinPrice = Number.isFinite(rawCoinPrice) && rawCoinPrice > 0 ? Math.floor(rawCoinPrice) : 25; %>
                  <% if (coinPrice > 0) { %>
                  <p class="mb-5 inline-flex items-center gap-1.5 rounded-xl border border-amber-400/30 bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold text-amber-200 w-fit">
                    <img src="<%= templateCoinIconPath %>" alt="coin" width="14" height="14" loading="lazy" decoding="async" class="h-3.5 w-3.5">
                    <span><%= coinPrice %> Coins</span>
                  </p>
                  <% } %>

                  <div class="grid grid-cols-2 gap-3 mt-auto">
                    <a href="/web/purchase/permanent/<%= sample.id %>"
                      class="flex items-center justify-center py-2.5 rounded-xl border border-slate-700 text-slate-300 font-semibold text-xs hover:bg-slate-800 transition">
                      Permanent link
                    </a>
                    <a href="/web/purchase/temporary/<%= sample.id %>"
                      class="submitBtnLink flex items-center justify-center py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-xs hover:bg-indigo-500 shadow-lg shadow-indigo-600/20 transition">
                      Make Link
                    </a>
                    <% if(currUser && currUser.isAdmin) { %>
                      <a href="/web/template/<%= sample.id %>/edit"
                        class="col-span-2 flex items-center justify-center py-2.5 rounded-xl border border-amber-500/40 bg-amber-500/10 text-amber-200 font-semibold text-xs hover:bg-amber-500/20 transition">
                        Edit Template
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
        </div>
      </div>

      <section class="mt-8 mb-10">
        <div class="flex items-center justify-between mb-4 border-b border-slate-800/60 pb-4">
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-white">Top Photo Frame Templates</h2>
            <p class="text-slate-500 text-sm mt-1">For Insta Story and WhatsApp Status</p>
          </div>
          <a href="/photo-frames"
            class="p-4 inline-flex items-center justify-center rounded-xl border border-indigo-500/40 bg-indigo-500/10 px-3.5 py-2 text-xs font-semibold text-indigo-300 hover:bg-indigo-500/20 transition">
            View All
          </a>
        </div>

        <% if (!homeTopPhotoFrameTemplates.length) { %>
          <p class="text-sm text-slate-400">Photo frame templates abhi available nahi hain.</p>
        <% } else { %>
          <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
            <% homeTopPhotoFrameTemplates.forEach((frameTemplate) => { %>
              <article class="group rounded-xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-indigo-500/50 transition">
                <a href="/photo-frames/<%= encodeURIComponent(frameTemplate.slug) %>" class="block">
                  <div class="aspect-[4/3] bg-slate-900 overflow-hidden">
                    <img
                      src="<%= frameTemplate.frameImage.previewUrl %>"
                      alt="<%= frameTemplate.name %> preview"
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                      width="<%= Number((frameTemplate.canvas && frameTemplate.canvas.width) || 1080) %>"
                      height="<%= Number((frameTemplate.canvas && frameTemplate.canvas.height) || 1080) %>"
                      class="h-full w-full object-contain group-hover:scale-[1.03] transition duration-300">
                  </div>
                  <div class="px-2.5 py-2.5">
                    <h3 class="text-xs md:text-sm font-semibold text-white line-clamp-2"><%= frameTemplate.name %></h3>
                  </div>
                </a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
  
    </main>
    <section class="max-w-5xl mx-auto mt-4 p-6 md:p-8 mb-6 rounded-3xl border border-slate-800/70 bg-slate-900/35"
      style="content-visibility:auto;contain-intrinsic-size:560px;">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Why Digital Wishes Work Better</h2>
      <p class="mt-3 text-sm md:text-base text-slate-300 leading-relaxed">
        VishLink makes gifting simple: choose a template, personalize your message, and share one beautiful link.
        No delivery delays, no printing, and your memory stays accessible anytime.
      </p>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-3">
          <p class="text-sm font-semibold text-indigo-300">Fast</p>
          <p class="mt-1 text-sm text-slate-300">Ready in minutes and easy to share.</p>
        </div>
        <div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-3">
          <p class="text-sm font-semibold text-emerald-300">Personal</p>
          <p class="mt-1 text-sm text-slate-300">Add your photos, message, and style.</p>
        </div>
        <div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-3">
          <p class="text-sm font-semibold text-amber-300">Reusable</p>
          <p class="mt-1 text-sm text-slate-300">Open and relive moments anytime.</p>
        </div>
      </div>
    </section>
    <section class="mx-4 sm:mx-6 lg:mx-auto max-w-5xl mt-2 mb-10">
      <div class="rounded-3xl border border-slate-800/80 bg-gradient-to-br from-slate-900/80 via-slate-900/65 to-indigo-950/35 p-5 md:p-7">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 md:gap-6">
          <div class="text-center lg:text-left lg:max-w-2xl">
            <p class="text-[11px] uppercase tracking-[0.16em] text-indigo-300 font-semibold">Quick Explore</p>
            <h2 class="mt-2 text-xl md:text-2xl font-bold text-white leading-tight">Create Personalized Wishing Websites Online</h2>
            <p class="mt-2 text-sm md:text-base text-slate-300">
              Explore birthday, anniversary, and digital gift website ideas with ready templates on VishLink.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full lg:w-auto lg:min-w-[420px]">
            <a href="/birthday-gift-website" class="inline-flex items-center justify-center rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2.5 text-sm font-semibold text-indigo-100 hover:bg-indigo-500/20 hover:border-indigo-400/40 transition">
              Birthday Gift Website
            </a>
            <a href="/anniversary-gift-website" class="inline-flex items-center justify-center rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2.5 text-sm font-semibold text-indigo-100 hover:bg-indigo-500/20 hover:border-indigo-400/40 transition">
              Anniversary Website
            </a>
            <a href="/online-wishing-website-maker" class="inline-flex items-center justify-center rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2.5 text-sm font-semibold text-indigo-100 hover:bg-indigo-500/20 hover:border-indigo-400/40 transition">
              Wishing Website Maker
            </a>
            <a href="/digital-gift-ideas" class="inline-flex items-center justify-center rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2.5 text-sm font-semibold text-indigo-100 hover:bg-indigo-500/20 hover:border-indigo-400/40 transition">
              Digital Gift Ideas
            </a>
          </div>
        </div>
      </div>
    </section>

    <script defer src="/homeCollection.js?v=<%= assetVersion %>"></script>

  </div>

