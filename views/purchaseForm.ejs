<% layout("/layouts/boilerplate") %>
<%
  const temporaryPrice = Number(selectedWeb?.priceForTemporary || 0);
  const permanentPrice = Number(selectedWeb?.priceForPermanent || 0);
  const fallbackAmount = isTemporary ? temporaryPrice : permanentPrice;
  const payableAmount = Number.isFinite(Number(paymentAmount)) ? Number(paymentAmount) : fallbackAmount;
  const requiresPayment = payableAmount > 0;
  const fallbackCoinPrice = Number(selectedWeb?.purchaseCredits);
  const resolvedCoinPrice = Number.isFinite(Number(coinPrice)) ? Number(coinPrice) : fallbackCoinPrice;
  const templateCoinPrice = Number.isFinite(resolvedCoinPrice)
    ? Math.max(0, Math.floor(resolvedCoinPrice))
    : 0;
  const canUseCoins = isTemporary && templateCoinPrice > 0;
  const currentUserCoins = Number.isFinite(Number(userCredits)) ? Math.max(0, Number(userCredits)) : 0;
  const hasEnoughCoins = currentUserCoins >= templateCoinPrice;
  const requestedDefaultMode = String(defaultPaymentMode || "upi").toLowerCase();
  const initialPaymentMode =
    requestedDefaultMode === "coins" && canUseCoins && hasEnoughCoins ? "coins" : "upi";
  const coinValidityMonths = Number.isFinite(Number(coinPurchaseValidityMonths))
    ? Math.max(1, Number(coinPurchaseValidityMonths))
    : 3;
  const upiValidityMonths = Number.isFinite(Number(moneyPurchaseValidityMonths))
    ? Math.max(1, Number(moneyPurchaseValidityMonths))
    : 6;
  const resolvedUpiLinks = upiLinks || {};
  const universalUpiLink = autoPaymentLink || resolvedUpiLinks.upi || "";
  const intentUpiLink = resolvedUpiLinks.intent || "";
  const hasAutoPayment = Boolean(universalUpiLink);
  const hasManualQr = Boolean(paymentQrImageUrl);
  const displayPaymentAmount = Number.isFinite(payableAmount) ? payableAmount.toFixed(2) : "0.00";
%>

<style>
  .purchase-accordion summary::-webkit-details-marker {
    display: none;
  }

  .payment-upi-id {
    word-break: break-all;
  }
</style>

  <body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col">
    <div class=" w-full flex mt-4 items-center justify-center">
          <h1 class="text-2xl font-extrabold leading-tight">
            Create your <span class="text-indigo-500">Link</span>
          </h1>
    </div>
    <main class="flex-grow flex items-center justify-center px-6 py-12">
      
      <div class="max-w-5xl w-full flex flex-col gap-4 items-center">

        <details class="purchase-accordion bg-slate-900/20 border border-slate-800/30 p-4 rounded-2xl w-full">
          <summary class="cursor-pointer flex items-center justify-between text-slate-300 font-semibold text-sm md:text-base" style="list-style:none;">
            <span>Privacy & Security</span>
            <span class="text-xs text-slate-400">&#9662;</span>
          </summary>
          <p class="mt-3 text-slate-400 text-sm leading-relaxed">
            All VishLink websites are fully secure. When a link is deleted or expires, all associated images, messages, and data are permanently removed from our systems. We do not share, transfer, or sell user data to any third party. All submitted details remain securely stored with us and are protected at all times.
          </p>
        </details>
        <details class="purchase-accordion bg-amber-500/10 border border-amber-500/20 p-4 rounded-2xl w-full">
          <summary class="cursor-pointer flex items-center justify-between text-amber-300 font-semibold text-sm md:text-base" style="list-style:none;">
            <% if (canUseCoins) { %>
              <span>UPI purchase expires in <%= upiValidityMonths %> months | Coins purchase expires in <%= coinValidityMonths %> months</span>
            <% } else { %>
              <span>UPI purchase expires in <%= upiValidityMonths %> months</span>
            <% } %>
            <span class="text-xs text-amber-300">&#9662;</span>
          </summary>
          <p class="mt-3 text-amber-100/90 text-sm leading-relaxed">
            <% if (canUseCoins) { %>
              Coin payment unlocks your link instantly for <%= coinValidityMonths %> months, and UPI payment keeps it valid for <%= upiValidityMonths %> months.
            <% } else { %>
              UPI payment keeps this link valid for <%= upiValidityMonths %> months.
            <% } %>
          </p>
        </details>

        <details class="purchase-accordion w-full rounded-2xl border border-indigo-500/25 bg-indigo-500/10 p-4">
          <summary class="cursor-pointer flex items-center justify-between text-indigo-200 font-semibold text-sm md:text-base" style="list-style:none;">
            <span>Multiple Attempts Allowed</span>
            <span class="text-xs text-indigo-200">&#9662;</span>
          </summary>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            Not happy with current output? Create a new attempt and reuse the same payment screenshot.
            Once the new link is created, the old one is removed automatically.
          </p>
        </details>

        <!-- MAIN FORM -->
        
        <div class="glass-effect p-8 md:p-10 rounded-3xl shadow-2xl">
            <br>
            <p class="text-emerald-500 text-lg mb-2">All created links will be shown in your profile.</p>         

          <% if( !isTemporary ){ %>
            <div id="paymentVerificationNote" class="mt-4 mb-4 inline-flex items-center gap-2 px-4 py-2 <%= initialPaymentMode === 'coins' ? 'hidden' : '' %>
            bg-amber-500/5 text-amber-600 
            rounded-xl text-xs font-medium 
            tracking-wide border border-amber-500/10">
              The created link will appear on your profile within 24&ndash;48 hours after payment verification.
            </div>
          <% } %>

            <hr style="opacity: 0.4;">
              <br>
              <form id="BuyForm" action="/web/purchase/<%= isTemporary ? 'temporary' : 'permanent' %>/<%= id %>" method="POST" class="space-y-5" enctype="multipart/form-data">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  
                  <div>
                    <label class="block text-sm font-medium mb-2 text-slate-400">Website name</label>
                    <input name="purchase[webName]" class="w-full px-4 py-3 rounded-xl form-input text-white"
                      value= "<%= JSON.stringify(selectedWeb.webName).slice(1, -1) %>" readonly >
                  </div>

                  <% if( !isTemporary ){ %>
                    <input type="hidden" name="purchase[isTemporary]" value="false">
                  <% } %>

                  <% if( isTemporary ){ %>
                    <input type="hidden" name="purchase[isTemporary]" value="true">
                  <% } %>

                  <% if (canUseCoins) { %>
                    <div class="col-span-1 md:col-span-2">
                      <label class="block text-sm font-semibold mb-2 text-slate-300">Payment Method</label>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="cursor-pointer rounded-2xl border border-emerald-500/25 bg-emerald-500/10 px-4 py-3">
                          <input
                            type="radio"
                            name="purchase[paymentMode]"
                            value="upi"
                            class="mr-2 align-middle"
                            <%= initialPaymentMode === "upi" ? "checked" : "" %>>
                          <span class="align-middle text-sm font-semibold text-emerald-200">UPI / Screenshot</span>
                          <p class="mt-1 text-xs text-emerald-100/80">Your link goes live after manual verification.</p>
                        </label>
                        <label class="cursor-pointer rounded-2xl border border-amber-500/25 bg-amber-500/10 px-4 py-3 <%= hasEnoughCoins ? '' : 'opacity-70' %>">
                          <input
                            type="radio"
                            name="purchase[paymentMode]"
                            value="coins"
                            class="mr-2 align-middle"
                            <%= initialPaymentMode === "coins" ? "checked" : "" %>
                            <%= hasEnoughCoins ? "" : "disabled" %>>
                          <span class="align-middle text-sm font-semibold text-amber-200">Coins</span>
                          <p class="mt-1 text-xs text-amber-100/90">
                            <strong><%= templateCoinPrice %> coins</strong> | Balance: <%= currentUserCoins %>
                          </p>
                          <p class="mt-1 text-xs text-amber-100/80">Instant unlock, expiry <%= coinValidityMonths %> months.</p>
                        </label>
                      </div>
                      <% if (!hasEnoughCoins) { %>
                        <p id="coinInsufficientMessage" class="mt-2 text-xs text-rose-300">
                          Your coin balance is too low. Use UPI mode or collect more coins from daily rewards.
                        </p>
                      <% } %>
                    </div>
                  <% } else { %>
                    <input type="hidden" name="purchase[paymentMode]" value="upi">
                  <% } %>

                  <div>
                    <label class="block text-sm font-medium mb-2 text-slate-400">Receiver</label>
                    <input name="purchase[receiver]" type="text" placeholder="ex. Natasha"
                      class="w-full px-4 py-3 rounded-xl form-input text-white" required>
                  </div>

                  <div>
                    <label class="block text-sm font-medium mb-2 text-slate-400">Sender</label>
                    <input name="purchase[sender]" type="text" placeholder="ex. Tom"
                      class="w-full px-4 py-3 rounded-xl form-input text-white" required>
                  </div>

                  <% if(selectedWeb.imageNeeded != 0){ %>
                  <div class="col-span-1 md:col-span-2">
                      <label class="block text-sm font-semibold mb-2 text-slate-300 ml-1 flex justify-between">
                        <span>Upload Images</span>
                        <span class="text-indigo-400 text-xs bg-indigo-500/10 px-2 py-0.5 rounded">Required: <%= selectedWeb.imageNeeded %></span>
                      </label>
                      <p class="text-xs text-amber-500/80 mb-2 ml-1">Please upload exactly <%= selectedWeb.imageNeeded %> images for the best result.</p>
                      <input name="images" id="images" type="file" multiple accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" data-required="<%= selectedWeb.imageNeeded %>"
                        class="w-full px-4 py-3 rounded-xl form-input text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-500/10 file:text-indigo-400 hover:file:bg-indigo-500/20" required >
                  </div>
                  <% } %>

                    <div class="col-span-1 md:col-span-2">
                      <label class="block text-sm font-medium mb-2 text-slate-400">Special message</label>
                      <textarea name="purchase[specialMsg]" maxlength="350" rows="5"
                        placeholder="Wishing you endless happiness, good health, and success in everything you do..."
                        class="w-full px-4 py-3 rounded-xl form-input text-white" required></textarea>
                    </div>

                  <% if (canUseCoins) { %>
                    <div id="coinPaymentSection" class="col-span-1 md:col-span-2 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 <%= initialPaymentMode === 'coins' ? '' : 'hidden' %>">
                      <h3 class="text-sm font-semibold text-amber-200">Coins Checkout</h3>
                      <p class="mt-2 text-sm text-amber-100/90">
                        This template requires <strong><%= templateCoinPrice %> coins</strong>.
                      </p>
                      <p class="mt-1 text-xs text-amber-100/80">Current balance: <%= currentUserCoins %> coins.</p>
                      <p class="mt-1 text-xs text-amber-100/80">After coin purchase, this link stays valid for <%= coinValidityMonths %> months.</p>
                    </div>
                  <% } %>

                  <% if(requiresPayment){ %>
                    <div id="upiPaymentSection" class="col-span-1 md:col-span-2 <%= initialPaymentMode === 'coins' ? 'hidden' : '' %>">
                      <details class="purchase-accordion rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4">
                        <summary class="cursor-pointer flex items-center justify-between text-emerald-300 font-semibold text-sm" style="list-style:none;">
                          <span>Price - &#8377;<%= displayPaymentAmount %></span>
                          <span class="inline-flex items-center gap-2 ml-auto">
                            <span class="text-xs text-emerald-200">&#9662;</span>
                            <% if(hasAutoPayment) { %>
                              <a
                                href="<%= universalUpiLink %>"
                                id="upiPayBtn"
                                data-intent-link="<%= intentUpiLink %>"
                                class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-3 py-1.5 text-xs text-white font-semibold hover:bg-emerald-500 transition">
                                Pay
                              </a>
                            <% } %>
                          </span>
                        </summary>

                        <div class="mt-4 flex flex-col items-center space-y-4">
                          <% if(hasManualQr) { %>
                            <div class="flex flex-col items-center gap-3 rounded-xl border border-slate-700/60 bg-slate-900/35 p-3">
                              <div class="QRcodeBox">
                                <img src="<%= getOptimizedCloudinaryUrl(paymentQrImageUrl, 'payment') %>" srcset="<%= getResponsiveCloudinarySrcSet(paymentQrImageUrl, 'payment') %>" sizes="160px" alt="Payment QR Code" loading="lazy" decoding="async">
                              </div>
                            </div>
                          <% } %>

                          <% if(!hasAutoPayment) { %>
                            <p class="text-xs text-amber-300">UPI payment button not configured.</p>
                          <% } %>
                        </div>
                      </details>
                    </div>
                  <% } %>

                  <% if(requiresPayment){ %>
                    <div id="upiProofSection" class="col-span-1 md:col-span-2 <%= initialPaymentMode === 'coins' ? 'hidden' : '' %>">
                      <label class="block text-sm font-semibold mb-2 text-slate-300">Payment Screenshot</label>
                      <input id="paymentImageInput" name="paymentImage" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
                          class="w-full px-4 py-3 rounded-xl form-input text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-emerald-500/10 file:text-emerald-400 hover:file:bg-emerald-500/20" <%= initialPaymentMode === 'coins' ? '' : 'required' %>>
                    </div>
                  <% } %>

                </div>

                <button type="submit" id="submitBtn"
                  class="w-full gradient-bg py-4 rounded-xl font-bold text-white shadow-lg shadow-indigo-500/30 hover:opacity-90 transition transform hover:-translate-y-1">
                  <%= initialPaymentMode === "coins" ? "Unlock With Coins" : "Create Link" %>
                </button>
              </form>
        </div>
        <details class="purchase-accordion w-full mt-2 bg-slate-900/20 border border-slate-800/30 p-4 rounded-2xl">
          <summary class="cursor-pointer flex items-center justify-between text-slate-300 font-semibold text-sm md:text-base" style="list-style:none;">
            <span>Need help or support?</span>
            <span class="text-xs text-slate-400">&#9662;</span>
          </summary>
          <p class="mt-3 text-sm text-slate-400 leading-relaxed">
            Need quick help? Connect with us on
            <a class="text-indigo-400 hover:text-indigo-300" href="/chat">Chat Support</a>
            or message us on
            <a class="text-pink-400 hover:text-pink-300" href="https://www.instagram.com/vish_link18/#" target="_blank" rel="noopener noreferrer">Instagram</a>.
            <br>
            If you want any customizations or need a special template, just talk to Chat Support and we will help you set it up.
          </p>
        </details>

        <% if(selectedWeb.articleTitle){ %>
        <article class="bg-slate-900/30 border border-slate-800/50 p-6 md:p-10 rounded-3xl">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 flex items-center gap-4">
            <span class="w-12 h-12 bg-indigo-500/20 rounded-xl flex items-center justify-center text-indigo-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10.392A7.969 7.969 0 015.5 14c1.255 0 2.443.29 3.5.804V4.804zM11 4.804A7.968 7.968 0 0114.5 4c1.255 0 2.443.29 3.5.804v10.392a7.969 7.969 0 00-3.5-.804c-1.255 0-2.443.29-3.5.804V4.804z" /></svg>
            </span>
            <%= selectedWeb.articleTitle %>
          </h2>
          <p class="text-slate-400 leading-relaxed text-base md:text-lg">
            <%- selectedWeb.articleContent %>
          </p>
        </article>
        <% } %>
      </div>
    </main>
    

    <script>
      const imagesInput = document.getElementById("images");
      if (imagesInput) {
        imagesInput.addEventListener("change", function () {
          const requiredCount = Number(this.dataset.required || 0);
          if (this.files.length > 5) {
            alert("Maximum 5 images allowed");
            this.value = "";
            return;
          }
          if (requiredCount > 0 && this.files.length < requiredCount) {
            alert(`Please select at least ${requiredCount} images.`);
            this.value = "";
          }
        });
      }

      function getTargetWidth() {
        if (window.innerWidth <= 640) return 480;
        if (window.innerWidth <= 1024) return 768;
        return 1200;
      }

      function loadImage(file) {
        return new Promise((resolve, reject) => {
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);
          img.onload = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(img);
          };
          img.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            reject(new Error("Failed to load image"));
          };
          img.src = objectUrl;
        });
      }

      async function optimizeImageFile(file) {
        if (!file || !String(file.type || "").startsWith("image/")) return file;

        const img = await loadImage(file);
        const maxWidth = getTargetWidth();
        const scale = Math.min(1, maxWidth / img.width);
        const width = Math.round(img.width * scale);
        const height = Math.round(img.height * scale);

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const context = canvas.getContext("2d");
        context.drawImage(img, 0, 0, width, height);

        const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.8));
        if (!blob || blob.size >= file.size) return file;

        const safeName = file.name.replace(/\.[^/.]+$/, "");
        return new File([blob], `${safeName}.webp`, { type: "image/webp", lastModified: Date.now() });
      }

      async function optimizeInputFiles(inputElement) {
        if (!inputElement || !inputElement.files || !inputElement.files.length) return;
        if (typeof DataTransfer === "undefined") return;
        const optimized = await Promise.all(Array.from(inputElement.files).map(optimizeImageFile));
        const dataTransfer = new DataTransfer();
        optimized.forEach((file) => dataTransfer.items.add(file));
        inputElement.files = dataTransfer.files;
      }
      
      const form = document.getElementById("BuyForm");
      const btn = document.getElementById("submitBtn");
      const upiPayBtn = document.getElementById("upiPayBtn");
      const paymentModeInputs = Array.from(
        document.querySelectorAll('input[name="purchase[paymentMode]"]')
      );
      const upiPaymentSection = document.getElementById("upiPaymentSection");
      const upiProofSection = document.getElementById("upiProofSection");
      const paymentImageInput = document.getElementById("paymentImageInput");
      const coinPaymentSection = document.getElementById("coinPaymentSection");
      const verificationNote = document.getElementById("paymentVerificationNote");
      const coinOptionEnabled = <%= canUseCoins ? "true" : "false" %>;
      const hasEnoughCoinsForPurchase = <%= hasEnoughCoins ? "true" : "false" %>;
      const upiProofRequired = <%= requiresPayment ? "true" : "false" %>;

      function getSelectedPaymentMode() {
        if (!paymentModeInputs.length) return "upi";
        const checkedInput = paymentModeInputs.find((input) => input.checked);
        return checkedInput ? String(checkedInput.value || "upi").toLowerCase() : "upi";
      }

      function setVisibility(element, visible) {
        if (!element) return;
        element.classList.toggle("hidden", !visible);
      }

      function syncPaymentModeUi() {
        const mode = getSelectedPaymentMode();
        const usingCoins = coinOptionEnabled && mode === "coins";

        setVisibility(coinPaymentSection, usingCoins);
        setVisibility(upiPaymentSection, !usingCoins && upiProofRequired);
        setVisibility(upiProofSection, !usingCoins && upiProofRequired);
        setVisibility(verificationNote, !usingCoins && Boolean(verificationNote));

        if (paymentImageInput) {
          paymentImageInput.required = !usingCoins && upiProofRequired;
        }

        if (!btn) return;

        if (usingCoins) {
          if (!hasEnoughCoinsForPurchase) {
            btn.disabled = true;
            btn.innerText = "Not Enough Coins";
            return;
          }
          btn.disabled = false;
          btn.innerText = "Unlock With Coins";
          return;
        }

        btn.disabled = false;
        btn.innerText = "Create Link";
      }

      paymentModeInputs.forEach((input) => {
        input.addEventListener("change", syncPaymentModeUi);
      });
      syncPaymentModeUi();

      if (upiPayBtn) {
        upiPayBtn.addEventListener("click", (event) => {
          event.stopPropagation();
          const upiLink = String(upiPayBtn.getAttribute("href") || "").trim();
          const intentLink = String(upiPayBtn.dataset.intentLink || "").trim();
          const userAgent = String(window.navigator.userAgent || "");
          const isMobile = /Android|iPhone|iPad|iPod/i.test(userAgent);
          const isAndroid = /Android/i.test(userAgent);

          if (!upiLink) {
            alert("UPI link is not configured yet.");
            return;
          }

          if (!isMobile) {
            alert("UPI apps open only on mobile. Please scan QR or open this page on your phone.");
            event.preventDefault();
            return;
          }

          event.preventDefault();
          window.location.href = upiLink;

          if (isAndroid && intentLink) {
            window.setTimeout(() => {
              window.location.href = intentLink;
            }, 900);
          }
        });
      }

      form.addEventListener("submit", async function (event) {
        if (form.dataset.optimizedSubmit === "true") return;
        event.preventDefault();
        const selectedMode = getSelectedPaymentMode();
        const usingCoins = coinOptionEnabled && selectedMode === "coins";

        if (usingCoins && !hasEnoughCoinsForPurchase) {
          alert("You do not have enough coins for this template.");
          return;
        }

        btn.disabled = true;
        btn.innerText = "Optimizing images...";

        try {
          await optimizeInputFiles(form.querySelector('input[name="images"]'));
          if (!usingCoins) {
            await optimizeInputFiles(form.querySelector('input[name="paymentImage"]'));
          }
        } catch (_err) {
          // If optimization fails, original images will still be uploaded.
        }

        form.dataset.optimizedSubmit = "true";
        btn.innerText = "Please wait...";
        form.submit();
      });

    </script>
</body>
