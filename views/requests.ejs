<% layout("/layouts/boilerplate") %>

    <body class="text-slate-200 min-h-screen">

        <main class="max-w-5xl mx-auto px-6 py-10">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-white">Incoming Requests</h1>
                    <p class="text-slate-400 mt-1">Review and manage link requests from users.</p>
                </div>
                <a href="/requests/expired" class="flex gap-2">
                    <span
                        class="bg-slate-800 text-slate-300 px-4 py-2 rounded-lg text-sm border border-slate-700">expired
                    </span>
                </a>
            </div>

            <div class="space-y-4">

                <% for(request of userPurchased) {%>
                    <div
                        class="request-card p-5 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
                        <div class="flex items-center gap-4 w-full md:w-auto">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Rahul"
                                class="w-12 h-12 rounded-xl bg-slate-700" alt="User">
                            <div>
                                <h3 class="font-bold text-white">
                                    <%= request.sender %>
                                </h3>
                                <p class="text-xs text-slate-500">
                                    <%= request.price %>
                                </p>
                            </div>
                        </div>

                        <img style="max-width: 250px; max-height: 350px;" src="<%= request.paymentProofUrl.url %>"
                            alt="paymentProof">

                        <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                            <form id="acceptForm" action="/requests/accept/<%= request._id %>">
                                <button id="acceptBtn" type="submit"
                                    class="flex-1 md:flex-none px-5 py-2 rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 hover:bg-emerald-500 hover:text-white transition font-semibold text-sm">
                                    Accept
                                </button>
                            </form>

                            <% if(request.isLive){ %>

                                <form id="deleteForm" action="/requests/delete/<%= request._id %>?_method=DELETE" method="POST">
                                    <button type="submit" id="deleteBtn"
                                        class="flex-1 md:flex-none px-5 py-2 rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20 hover:bg-rose-500 hover:text-white transition font-semibold text-sm">
                                        delete
                                    </button>
                                </form>

                            <% } %>
                        </div>
                    </div>
                    <% } %>


            </div>

        </main>
        <script>
        const form = document.getElementById("deleteForm");
        const btn = document.getElementById("deleteBtn");
        form.addEventListener("submit", function () {
            btn.disabled = true;
            btn.innerText = "Please wait...";
        });

        const acceptForm = document.getElementById("acceptForm");
        const acceptBtn = document.getElementById("acceptBtn");
        acceptForm.addEventListener("submit", function () {
            acceptBtn.disabled = true;
            acceptBtn.innerText = "Please wait...";
        });
    </script>
    </body>